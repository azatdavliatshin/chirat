{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm test)",
      "Bash(npm run *)",
      "Bash(bash repos/*)",
      "Bash(chirat-prompt *)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push*)",
      "Bash(claude --dangerously-skip-permissions*)"
    ]
  }
}
