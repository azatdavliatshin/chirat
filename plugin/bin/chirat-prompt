#!/usr/bin/env bash
# chirat-prompt — read and edit the YAML front matter of prompt files.
#
#   chirat-prompt get  <file> <key>           print the value of <key>
#   chirat-prompt set  <file> <key> <value>   set <key> in place, keep the rest
#   chirat-prompt unset <file> <key>          remove <key> from the front matter
#   chirat-prompt next <workspace>            print the next pending prompt
#   chirat-prompt waiting <workspace>         list pending prompts held back by after:
#   chirat-prompt check <workspace> <file>    exit 0 if <file>'s after: is satisfied
#   chirat-prompt lint <workspace>            list pending/running files with a bad name
#
# A change of `status` by `set` appends one line to
# <workspace>/.chirat/status.log (who called, so an unexpected flip can
# be traced): <iso time> <tab> <file rel to workspace> <tab> <old> <tab> <new>
# <tab> <pid> <tab> <ppid> <tab> <parent command> (basename; a shell script is named
# by its script). Other keys are not logged.
#
# Portable to GNU and BSD userland: GNU flags first, BSD as fallback (GNU fails
# on BSD flags; BSD flags do not fail on GNU).
#
# Front matter is the block between a first line `---` and the next `---`.
# Values are single-line `key: value`; a trailing ` # comment` is ignored.
#
# `status` is one of: pending | running | blocked | done | failed. `next`
# considers only `pending` files under <workspace>/<plans_dir>/, named
# <topic>.prompt-<N><suffix>.md with N digits and suffix empty, [a-z]+ (`5b`)
# or -[a-z0-9-]+ (`5-fix`). Order: N numerically, plain N before any suffix,
# suffixes in byte order (5 < 5-fix < 5b < 6), oldest mtime as the last
# tie-break (a queue). `next` exits 1 when the queue is empty.
#
# `lint` prints `<file> <tab> <reason>` for every <plans_dir>/*.md whose front
# matter says status pending or running but whose name does not match the
# pattern (such a file is never picked up); exit 1 if any, else 0. Files
# without front matter are ignored.
#
# Optional `after: <branch>`: the prompt is eligible only once <branch> is
# merged into <default_branch> of <workspace>/repos/<repo>. While the branch
# exists, `git merge-base --is-ancestor` decides. Once it is gone, only the
# recorded result can: the prompt that built it — same `repo:` and `branch:`;
# the last one in queue order when there are several — carries
# `commit: <full sha>` (written when its run finished), and that commit must
# be an ancestor of <default_branch>. Without a recorded commit the
# dependency stays unmet (the reason says so); a branch no prompt ever built
# is a planning error (warning on stderr). `after_mode: done` on the
# dependent prompt (default `merged`) opts out, for squash merges and for
# prompts from before `commit:` existed: satisfied as soon as that prompt is
# `done`, with a warning on stderr that this proves no merge; it is applied
# before the branch is looked at. Any other value leaves the prompt unmet.
#
# Optional <workspace>/.chirat/config (`key=value` lines, `#` comments, no
# quotes): plans_dir (default docs/plans), default_branch (default main).
# Paths are relative to the workspace root. Unknown keys are ignored; a line
# without `=` is a warning on stderr.

set -euo pipefail
export LC_ALL=C # byte-order suffix comparison and [a-z] without locale surprises

usage() {
  sed -n '4,10p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

die() {
  echo "chirat-prompt: $*" >&2
  exit 1
}

# chirat_config <ws> <key> <default>: value of <key> in <ws>/.chirat/config, else
# <default>. Identical copy lives in bin/chirat-watch (this script stays standalone).
chirat_config() {
  local f=$1/.chirat/config line k v val=$3 n=0
  if [ -f "$f" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      n=$((n + 1))
      line=${line#"${line%%[![:space:]]*}"}
      case $line in '' | '#'*) continue ;; esac
      case $line in
        *=*) ;;
        *) echo "chirat: warning: $f:$n: not key=value, ignored" >&2; continue ;;
      esac
      k=${line%%=*}
      v=${line#*=}
      k=${k%"${k##*[![:space:]]}"}
      v=${v#"${v%%[![:space:]]*}"}
      v=${v%"${v##*[![:space:]]}"}
      if [ "$k" = "$2" ] && [ -n "$v" ]; then val=$v; fi
    done <"$f"
  fi
  printf '%s\n' "$val"
}

has_front_matter() {
  [ "$(head -n 1 "$1")" = "---" ] &&
    awk 'NR > 1 && $0 == "---" { found = 1; exit } END { exit !found }' "$1"
}

cmd_get() {
  local file=$1 key=$2
  [ -f "$file" ] || die "no such file: $file"
  has_front_matter "$file" || die "no front matter: $file"
  awk -v key="$key" '
    NR == 1 { next }
    $0 == "---" { exit 1 }
    {
      k = $0; sub(/:.*/, "", k)
      if (k != key) next
      v = $0; sub(/^[^:]*:[ \t]*/, "", v)
      sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v)
      print v; found = 1; exit 0
    }
    END { if (!found) exit 1 }
  ' "$file"
}

# find_ws <file>: print the workspace whose <plans_dir> holds <file>, else fail.
find_ws() {
  local dir a pd
  dir=$(cd "$(dirname "$1")" 2>/dev/null && pwd -P) || return 1
  a=$dir
  while [ "$a" != / ]; do
    a=$(dirname "$a")
    pd=$(chirat_config "$a" plans_dir docs/plans 2>/dev/null)
    if [ "$(cd "$a/$pd" 2>/dev/null && pwd -P)" = "$dir" ]; then
      printf '%s\n' "$a"
      return 0
    fi
  done
  return 1
}

# log_status_change <file> <old> <new>: append to <ws>/.chirat/status.log
# (<ws> = the workspace whose plans_dir holds <file>). Never fails the caller.
log_status_change() {
  local ws rel runs parent pd
  if ! ws=$(find_ws "$1"); then
    echo "chirat-prompt: warning: $1 is not under <workspace>/<plans_dir>/, status change not logged" >&2
    return 0
  fi
  pd=$(chirat_config "$ws" plans_dir docs/plans 2>/dev/null)
  rel=$pd/${1##*/}
  runs=$ws/.chirat
  parent=$(ps -o comm= -p "$PPID" 2>/dev/null) || parent=""
  parent=${parent##*/}
  case $parent in # a script shows up as its interpreter: name the script instead
    bash | sh | zsh | dash)
      read -r _ arg _ <<<"$(ps -o args= -p "$PPID" 2>/dev/null)"
      case ${arg:-} in '' | -*) ;; *) parent=${arg##*/} ;; esac
      ;;
  esac
  parent=${parent:--}
  if ! { mkdir -p "$runs" && printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date +%Y-%m-%dT%H:%M:%S%z)" "$rel" "$2" "$3" "$$" "$PPID" "$parent" >>"$runs/status.log"; } 2>/dev/null; then
    echo "chirat-prompt: warning: cannot write $runs/status.log" >&2
  fi
  return 0
}

cmd_set() {
  local file=$1 key=$2 value=$3 tmp old=""
  [ -f "$file" ] || die "no such file: $file"
  has_front_matter "$file" || die "no front matter: $file"
  case $value in *$'\n'*) die "value must be a single line" ;; esac
  [ "$key" = status ] && { old=$(cmd_get "$file" status 2>/dev/null) || old=""; }
  tmp=$(mktemp "${file}.XXXXXX")
  awk -v key="$key" -v value="$value" '
    NR == 1 { print; next }
    !done && $0 == "---" {
      if (!seen) print key ": " value
      done = 1; print; next
    }
    !done {
      k = $0; sub(/:.*/, "", k)
      if (k == key) {
        comment = ""
        if (match($0, /[ \t]+#.*$/)) comment = substr($0, RSTART)
        print key ": " value comment; seen = 1; next
      }
    }
    { print }
  ' "$file" >"$tmp"
  # Keep the original file's permissions; mv alone would carry mktemp's 0600.
  chmod "$(stat -c %a "$file" 2>/dev/null || stat -f %Lp "$file")" "$tmp"
  mv "$tmp" "$file"
  if [ "$key" = status ] && [ "$old" != "$value" ]; then log_status_change "$file" "$old" "$value"; fi
  return 0
}

cmd_unset() {
  local file=$1 key=$2 tmp
  [ -f "$file" ] || die "no such file: $file"
  has_front_matter "$file" || die "no front matter: $file"
  tmp=$(mktemp "${file}.XXXXXX")
  awk -v key="$key" '
    NR == 1 { print; next }
    !done && $0 == "---" { done = 1; print; next }
    !done {
      k = $0; sub(/:.*/, "", k)
      if (k == key) next
    }
    { print }
  ' "$file" >"$tmp"
  chmod "$(stat -c %a "$file" 2>/dev/null || stat -f %Lp "$file")" "$tmp"
  mv "$tmp" "$file"
  return 0
}

mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"
}

# parse_stem <file>: split <topic>.prompt-<N><suffix>.md into the globals
# PROMPT_N (digits) and PROMPT_SUFFIX (maybe empty); return 1 on no match.
# The one place the file name pattern lives.
parse_stem() {
  local base=${1##*/}
  [[ $base =~ ^.+\.prompt-([0-9]+)([a-z]+|-[a-z0-9-]+)?\.md$ ]] || return 1
  PROMPT_N=${BASH_REMATCH[1]}
  PROMPT_SUFFIX=${BASH_REMATCH[2]:-}
}

# result_prompt <workspace> <plans_dir> <repo> <branch> <except>: the prompt
# that built <branch> in <repo> — same `repo:` and `branch:`, not <except>; the
# last in queue order (N, then suffix, as `next` orders) when there are
# several — or nothing.
result_prompt() {
  local ws=$1 pd=$2 repo=$3 br=$4 skip=$5 p best="" best_n="" best_s="" n suf
  for p in "$ws/$pd"/*.prompt-*.md; do
    [ -f "$p" ] || continue
    [ "$p" != "$skip" ] || continue
    parse_stem "$p" || continue
    [ "$(cmd_get "$p" branch 2>/dev/null)" = "$br" ] || continue
    [ "$(cmd_get "$p" repo 2>/dev/null)" = "$repo" ] || continue
    n=$((10#$PROMPT_N)) suf=$PROMPT_SUFFIX
    if [ -z "$best" ] || [ "$n" -gt "$best_n" ] || { [ "$n" -eq "$best_n" ] && [[ $suf > $best_s ]]; }; then
      best=$p best_n=$n best_s=$suf
    fi
  done
  [ -n "$best" ] && printf '%s\n' "$best"
  return 0
}

# after_unmet <workspace> <file>: print why <file>'s after: is not satisfied
# and return 1; return 0 (silent on stdout) when there is no after: or it is
# satisfied. Rules in the header.
after_unmet() {
  local ws=$1 f=$2 after repo r p db pd mode commit
  db=$(chirat_config "$ws" default_branch main 2>/dev/null)
  pd=$(chirat_config "$ws" plans_dir docs/plans 2>/dev/null)
  after=$(cmd_get "$f" after 2>/dev/null) || return 0
  [ -n "$after" ] || return 0
  mode=$(cmd_get "$f" after_mode 2>/dev/null) || mode=""
  [ -n "$mode" ] || mode=merged
  case $mode in
    merged | done) ;;
    *) echo "after_mode: unknown value '$mode' (merged | done)"; return 1 ;;
  esac
  repo=$(cmd_get "$f" repo 2>/dev/null) || repo=""
  r=$ws/repos/$repo
  if [ -z "$repo" ] || ! git -C "$r" rev-parse --git-dir >/dev/null 2>&1; then
    echo "repos/$repo is not a git repository"
    return 1
  fi
  if [ "$mode" = "done" ]; then
    p=$(result_prompt "$ws" "$pd" "$repo" "$after" "$f")
    if [ -n "$p" ] && [ "$(cmd_get "$p" status 2>/dev/null)" = "done" ]; then
      echo "chirat-prompt: warning: ${f#"$ws"/}: after_mode: done — $after counts as satisfied because ${p#"$ws"/} is done; this does not prove a merge into $db" >&2
      return 0
    fi
    echo "branch $after: no done prompt with repo: $repo and branch: $after (after_mode: done)"
    return 1
  fi
  git -C "$r" rev-parse --verify -q "refs/heads/$db" >/dev/null || { echo "branch $db not found in repos/$repo"; return 1; }
  if git -C "$r" rev-parse --verify -q "refs/heads/$after" >/dev/null; then
    git -C "$r" merge-base --is-ancestor "refs/heads/$after" "refs/heads/$db" && return 0
    echo "branch $after is not merged into $db"
    return 1
  fi
  # Branch is gone: only the recorded result commit can prove the merge.
  p=$(result_prompt "$ws" "$pd" "$repo" "$after" "$f")
  commit=""
  [ -z "$p" ] || { commit=$(cmd_get "$p" commit 2>/dev/null) || commit=""; }
  if [ -z "$commit" ]; then
    echo "branch $after is gone and no result commit is recorded; merge it or set \`after_mode: done\`"
    [ -n "$p" ] || echo "chirat-prompt: warning: ${f#"$ws"/}: after: branch $after does not exist in repos/$repo and no prompt built it (never created?)" >&2
    return 1
  fi
  if ! git -C "$r" cat-file -e "$commit^{commit}" 2>/dev/null; then
    echo "branch $after is gone and its result commit $commit is not in repos/$repo"
    return 1
  fi
  git -C "$r" merge-base --is-ancestor "$commit" "refs/heads/$db" && return 0
  echo "branch $after is gone and its result commit ${commit:0:7} is not merged into $db"
  return 1
}

cmd_check() {
  local reason
  [ -f "$2" ] || die "no such file: $2"
  reason=$(after_unmet "$1" "$2") || { printf '%s\n' "$reason"; exit 1; }
}

cmd_waiting() {
  local ws=$1 f status after reason pd
  pd=$(chirat_config "$ws" plans_dir docs/plans)
  [ -d "$ws/$pd" ] || die "no $pd in workspace: $ws"
  for f in "$ws/$pd"/*.prompt-*.md; do
    [ -f "$f" ] || continue
    parse_stem "$f" || continue
    status=$(cmd_get "$f" status 2>/dev/null) || continue
    [ "$status" = pending ] || continue
    reason=$(after_unmet "$ws" "$f") && continue
    after=$(cmd_get "$f" after)
    printf '%s\tafter=%s\t%s\n' "$f" "$after" "$reason"
  done
}

cmd_lint() {
  local ws=$1 f status bad=0 pd
  pd=$(chirat_config "$ws" plans_dir docs/plans)
  [ -d "$ws/$pd" ] || die "no $pd in workspace: $ws"
  for f in "$ws/$pd"/*.md; do
    [ -f "$f" ] || continue
    parse_stem "$f" && continue
    status=$(cmd_get "$f" status 2>/dev/null) || continue
    case $status in pending | running) ;; *) continue ;; esac
    printf '%s\tname does not match <topic>.prompt-<N><suffix>.md\n' "$f"
    bad=1
  done
  exit "$bad"
}

cmd_next() {
  local ws=$1 f n suf status best="" best_n="" best_s="" best_m="" m pd
  pd=$(chirat_config "$ws" plans_dir docs/plans)
  [ -d "$ws/$pd" ] || die "no $pd in workspace: $ws"
  for f in "$ws/$pd"/*.prompt-*.md; do
    [ -f "$f" ] || continue
    parse_stem "$f" || continue
    n=$((10#$PROMPT_N)) suf=$PROMPT_SUFFIX
    status=$(cmd_get "$f" status 2>/dev/null) || continue
    [ "$status" = pending ] || continue
    after_unmet "$ws" "$f" >/dev/null || continue
    m=$(mtime "$f")
    if [ -z "$best" ] || [ "$n" -lt "$best_n" ] ||
      { [ "$n" -eq "$best_n" ] && [[ $suf < $best_s ]]; } ||
      { [ "$n" -eq "$best_n" ] && [ "$suf" = "$best_s" ] && [ "$m" -lt "$best_m" ]; }; then
      best=$f best_n=$n best_s=$suf best_m=$m
    fi
  done
  [ -n "$best" ] || exit 1
  printf '%s\n' "$best"
}

[ $# -ge 1 ] || usage
case $1 in
  get) [ $# -eq 3 ] || usage; cmd_get "$2" "$3" ;;
  set) [ $# -eq 4 ] || usage; cmd_set "$2" "$3" "$4" ;;
  unset) [ $# -eq 3 ] || usage; cmd_unset "$2" "$3" ;;
  next) [ $# -eq 2 ] || usage; cmd_next "$2" ;;
  waiting) [ $# -eq 2 ] || usage; cmd_waiting "$2" ;;
  check) [ $# -eq 3 ] || usage; cmd_check "$2" "$3" ;;
  lint) [ $# -eq 2 ] || usage; cmd_lint "$2" ;;
  -h | --help) usage ;;
  *) usage ;;
esac
