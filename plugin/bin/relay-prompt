#!/usr/bin/env bash
# relay-prompt — read and edit the YAML front matter of prompt files.
#
#   relay-prompt get  <file> <key>           print the value of <key>
#   relay-prompt set  <file> <key> <value>   set <key> in place, keep the rest
#   relay-prompt next <workspace>            print the next pending prompt
#   relay-prompt waiting <workspace>         list pending prompts held back by after:
#   relay-prompt check <workspace> <file>    exit 0 if <file>'s after: is satisfied
#   relay-prompt lint <workspace>            list pending/running files with a bad name
#
# A change of `status` by `set` appends one line to
# <workspace>/docs/status/runs/status.log (who called, so an unexpected flip can
# be traced): <iso time> <tab> <file rel to workspace> <tab> <old> <tab> <new>
# <tab> <pid> <tab> <ppid> <tab> <parent command> (basename; a shell script is named
# by its script). Other keys are not logged.
#
# Front matter is the block between a first line `---` and the next `---`.
# Values are single-line `key: value`; a trailing ` # comment` is ignored.
#
# `status` is one of: pending | running | blocked | done | failed. `next`
# considers only `pending` files under <workspace>/docs/plans/, named
# <topic>.prompt-<N><suffix>.md with N digits and suffix empty, [a-z]+ (`5b`)
# or -[a-z0-9-]+ (`5-fix`). Order: N numerically, plain N before any suffix,
# suffixes in byte order (5 < 5-fix < 5b < 6), oldest mtime as the last
# tie-break (a queue). `next` exits 1 when the queue is empty.
#
# `lint` prints `<file> <tab> <reason>` for every docs/plans/*.md whose front
# matter says status pending or running but whose name does not match the
# pattern (such a file is never picked up); exit 1 if any, else 0. Files
# without front matter are ignored.
#
# Optional `after: <branch>`: the prompt is eligible only once <branch> is
# merged into main of <workspace>/repos/<repo>. A branch that no longer exists
# counts as merged when the workspace shows it was built (a done prompt with
# that `branch:`, or a merge commit naming it); a branch that never existed is
# a planning error: the prompt waits and a warning goes to stderr.

set -euo pipefail
export LC_ALL=C # byte-order suffix comparison and [a-z] without locale surprises

usage() {
  sed -n '4,9p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

die() {
  echo "relay-prompt: $*" >&2
  exit 1
}

has_front_matter() {
  [ "$(head -n 1 "$1")" = "---" ] &&
    awk 'NR > 1 && $0 == "---" { found = 1; exit } END { exit !found }' "$1"
}

cmd_get() {
  local file=$1 key=$2
  [ -f "$file" ] || die "no such file: $file"
  has_front_matter "$file" || die "no front matter: $file"
  awk -v key="$key" '
    NR == 1 { next }
    $0 == "---" { exit 1 }
    {
      k = $0; sub(/:.*/, "", k)
      if (k != key) next
      v = $0; sub(/^[^:]*:[ \t]*/, "", v)
      sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v)
      print v; found = 1; exit 0
    }
    END { if (!found) exit 1 }
  ' "$file"
}

# log_status_change <file> <old> <new>: append to <ws>/docs/status/runs/status.log
# (<ws> = the directory holding docs/plans/<file>). Never fails the caller.
log_status_change() {
  local dir ws rel runs parent
  dir=$(cd "$(dirname "$1")" 2>/dev/null && pwd) || dir=""
  if [ "${dir##*/}" != plans ] || [ "$(basename "$(dirname "$dir")")" != docs ]; then
    echo "relay-prompt: warning: $1 is not under <workspace>/docs/plans/, status change not logged" >&2
    return 0
  fi
  ws=$(dirname "$(dirname "$dir")")
  rel=docs/plans/${1##*/}
  runs=$ws/docs/status/runs
  parent=$(ps -o comm= -p "$PPID" 2>/dev/null) || parent=""
  parent=${parent##*/}
  case $parent in # a script shows up as its interpreter: name the script instead
    bash | sh | zsh | dash)
      read -r _ arg _ <<<"$(ps -o args= -p "$PPID" 2>/dev/null)"
      case ${arg:-} in '' | -*) ;; *) parent=${arg##*/} ;; esac
      ;;
  esac
  parent=${parent:--}
  if ! { mkdir -p "$runs" && printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date +%Y-%m-%dT%H:%M:%S%z)" "$rel" "$2" "$3" "$$" "$PPID" "$parent" >>"$runs/status.log"; } 2>/dev/null; then
    echo "relay-prompt: warning: cannot write $runs/status.log" >&2
  fi
  return 0
}

cmd_set() {
  local file=$1 key=$2 value=$3 tmp old=""
  [ -f "$file" ] || die "no such file: $file"
  has_front_matter "$file" || die "no front matter: $file"
  case $value in *$'\n'*) die "value must be a single line" ;; esac
  [ "$key" = status ] && { old=$(cmd_get "$file" status 2>/dev/null) || old=""; }
  tmp=$(mktemp "${file}.XXXXXX")
  awk -v key="$key" -v value="$value" '
    NR == 1 { print; next }
    !done && $0 == "---" {
      if (!seen) print key ": " value
      done = 1; print; next
    }
    !done {
      k = $0; sub(/:.*/, "", k)
      if (k == key) {
        comment = ""
        if (match($0, /[ \t]+#.*$/)) comment = substr($0, RSTART)
        print key ": " value comment; seen = 1; next
      }
    }
    { print }
  ' "$file" >"$tmp"
  # Keep the original file's permissions; mv alone would carry mktemp's 0600.
  chmod "$(stat -f %Lp "$file" 2>/dev/null || stat -c %a "$file")" "$tmp"
  mv "$tmp" "$file"
  if [ "$key" = status ] && [ "$old" != "$value" ]; then log_status_change "$file" "$old" "$value"; fi
  return 0
}

mtime() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1"
}

# parse_stem <file>: split <topic>.prompt-<N><suffix>.md into the globals
# PROMPT_N (digits) and PROMPT_SUFFIX (maybe empty); return 1 on no match.
# The one place the file name pattern lives.
parse_stem() {
  local base=${1##*/}
  [[ $base =~ ^.+\.prompt-([0-9]+)([a-z]+|-[a-z0-9-]+)?\.md$ ]] || return 1
  PROMPT_N=${BASH_REMATCH[1]}
  PROMPT_SUFFIX=${BASH_REMATCH[2]:-}
}

# after_unmet <workspace> <file>: print why <file>'s after: is not satisfied
# and return 1; return 0 (silent) when there is no after: or it is satisfied.
after_unmet() {
  local ws=$1 f=$2 after repo r p
  after=$(cmd_get "$f" after 2>/dev/null) || return 0
  [ -n "$after" ] || return 0
  repo=$(cmd_get "$f" repo 2>/dev/null) || repo=""
  r=$ws/repos/$repo
  if [ -z "$repo" ] || ! git -C "$r" rev-parse --git-dir >/dev/null 2>&1; then
    echo "repos/$repo is not a git repository"
    return 1
  fi
  git -C "$r" rev-parse --verify -q refs/heads/main >/dev/null || { echo "branch main not found in repos/$repo"; return 1; }
  if git -C "$r" rev-parse --verify -q "refs/heads/$after" >/dev/null; then
    git -C "$r" merge-base --is-ancestor "refs/heads/$after" main && return 0
    echo "branch $after is not merged into main"
    return 1
  fi
  # Branch is gone: merged and deleted, or never created?
  for p in "$ws"/docs/plans/*.prompt-*.md; do
    [ -f "$p" ] || continue
    [ "$(cmd_get "$p" branch 2>/dev/null)" = "$after" ] &&
      [ "$(cmd_get "$p" status 2>/dev/null)" = "done" ] && return 0
  done
  [ -z "$(git -C "$r" log main -1 --format=%h --fixed-strings --grep="$after" 2>/dev/null)" ] || return 0
  echo "branch $after does not exist (never created?)"
  echo "relay-prompt: warning: $f: after: branch $after does not exist in repos/$repo" >&2
  return 1
}

cmd_check() {
  local reason
  [ -f "$2" ] || die "no such file: $2"
  reason=$(after_unmet "$1" "$2") || { printf '%s\n' "$reason"; exit 1; }
}

cmd_waiting() {
  local ws=$1 f status after reason
  [ -d "$ws/docs/plans" ] || die "no docs/plans in workspace: $ws"
  for f in "$ws"/docs/plans/*.prompt-*.md; do
    [ -f "$f" ] || continue
    parse_stem "$f" || continue
    status=$(cmd_get "$f" status 2>/dev/null) || continue
    [ "$status" = pending ] || continue
    reason=$(after_unmet "$ws" "$f" 2>/dev/null) && continue
    after=$(cmd_get "$f" after)
    printf '%s\tafter=%s\t%s\n' "$f" "$after" "$reason"
  done
}

cmd_lint() {
  local ws=$1 f status bad=0
  [ -d "$ws/docs/plans" ] || die "no docs/plans in workspace: $ws"
  for f in "$ws"/docs/plans/*.md; do
    [ -f "$f" ] || continue
    parse_stem "$f" && continue
    status=$(cmd_get "$f" status 2>/dev/null) || continue
    case $status in pending | running) ;; *) continue ;; esac
    printf '%s\tname does not match <topic>.prompt-<N><suffix>.md\n' "$f"
    bad=1
  done
  exit "$bad"
}

cmd_next() {
  local ws=$1 f n suf status best="" best_n="" best_s="" best_m="" m
  [ -d "$ws/docs/plans" ] || die "no docs/plans in workspace: $ws"
  for f in "$ws"/docs/plans/*.prompt-*.md; do
    [ -f "$f" ] || continue
    parse_stem "$f" || continue
    n=$((10#$PROMPT_N)) suf=$PROMPT_SUFFIX
    status=$(cmd_get "$f" status 2>/dev/null) || continue
    [ "$status" = pending ] || continue
    after_unmet "$ws" "$f" >/dev/null || continue
    m=$(mtime "$f")
    if [ -z "$best" ] || [ "$n" -lt "$best_n" ] ||
      { [ "$n" -eq "$best_n" ] && [[ $suf < $best_s ]]; } ||
      { [ "$n" -eq "$best_n" ] && [ "$suf" = "$best_s" ] && [ "$m" -lt "$best_m" ]; }; then
      best=$f best_n=$n best_s=$suf best_m=$m
    fi
  done
  [ -n "$best" ] || exit 1
  printf '%s\n' "$best"
}

[ $# -ge 1 ] || usage
case $1 in
  get) [ $# -eq 3 ] || usage; cmd_get "$2" "$3" ;;
  set) [ $# -eq 4 ] || usage; cmd_set "$2" "$3" "$4" ;;
  next) [ $# -eq 2 ] || usage; cmd_next "$2" ;;
  waiting) [ $# -eq 2 ] || usage; cmd_waiting "$2" ;;
  check) [ $# -eq 3 ] || usage; cmd_check "$2" "$3" ;;
  lint) [ $# -eq 2 ] || usage; cmd_lint "$2" ;;
  -h | --help) usage ;;
  *) usage ;;
esac
