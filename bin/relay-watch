#!/usr/bin/env bash
# relay-watch — poll workspaces for pending prompts and run them headless.
#
#   relay-watch [--once] [--dry-run] [--interval N] [--permission-mode M] [--tmux] [--version]
#   relay-watch install [dir] | status [ws…] | recover [--dry-run] [ws…] | restart [--force]
#
# Config: ~/.config/relay/workspaces ($XDG_CONFIG_HOME honoured) — one absolute
# workspace path per line, `#` comments, leading `~` expanded.
#
# Every --interval seconds (default 60) each workspace is asked for its next
# pending prompt (`relay-prompt next`). For a hit, relay-watch takes the lock
# <ws>/docs/status/runs/.lock, runs from <ws>
#
#   claude -p "/relay:next <file>" --model <model> --permission-mode <mode>
#          --permission-prompts none --output-format json
#
# with stdout in <ws>/docs/status/runs/<stem>.<YYYYMMDD-HHMMSS>.json and stderr
# appended to the matching .err, and marks the prompt `failed` if the run left
# it `running`. If <ws> is a git repository, the run log is then committed as
# `docs: run log <stem>` (docs/status/runs/ and docs/status/LATEST; never
# pushed). One line per run goes to ~/.local/state/relay/watch.log
# ($XDG_STATE_HOME honoured) and to stdout:
#
#   <iso time> <tab> <ws> <tab> <file> <tab> <model> <tab> <exit> <tab> <seconds>
#   <tab> <permission mode>
#
#   --once        single pass over all workspaces, then exit 0
#   --dry-run     print the claude command instead of running it
#   --interval N  seconds between passes (default 60)
#   --permission-mode M  claude permission mode, passed through verbatim;
#                 default `auto`, or $RELAY_PERMISSION_MODE (flag wins)
#   --tmux        start relay-watch (with the remaining flags) in a detached
#                 tmux session named `relay`; refuses if it already exists
#   --version     print the version and exit
#   install [dir] symlink relay-watch and relay-prompt into dir (default
#                 ~/.local/bin); refuses to replace anything that is not a
#                 symlink, hints at PATH if dir is not on it
#   status [ws…]  read-only report: watcher, tmux session, log, and per
#                 workspace the queue, the lock and the last run; exit 1 when
#                 anything is STALE. A bare name (`aat`) matches `*/aat`
#   recover [--dry-run] [ws…]
#                 the stale-lock recovery below, on demand; --dry-run only
#                 prints what would be done; refuses a workspace whose lock
#                 is live
#   restart [--force]
#                 stop the watcher and start `relay-watch --tmux` again with
#                 the same flags; refused while a claude is running unless
#                 --force (the prompt then goes back to `pending`)
#
# A running watcher records itself in the state dir (next to watch.log):
# watcher.pid and watcher.flags (its flags, one per line). Both are removed
# when it exits, unless a newer watcher has overwritten them. status and
# restart read them.
#
# A pending prompt with an unmet `after: <branch>` is skipped by `next`. When a
# pass finds nothing to run, each such prompt is logged as
#   <iso time> <tab> waiting <tab> <ws> <tab> <file> <tab> after=<branch>
# at most once per 10 minutes (state in <log dir>/waiting.seen).
#
# A pending or running file in docs/plans/ whose name does not match
# <topic>.prompt-<N><suffix>.md is never picked up (`relay-prompt lint`). Each
# pass logs it, once per file ever (state in <log dir>/misnamed.seen):
#   <iso time> <tab> misnamed <tab> <ws> <tab> <file> <tab> <reason>
#
# The lock directory records its owners: watcher.pid (relay-watch), prompt
# (path relative to the workspace), run (<stem>.<stamp>, the basename of the
# .json/.err), started (iso time) and, once claude is up, claude.pid. claude
# runs in its own process group (group id = claude.pid). Before every
# `relay-prompt next`, a lock is stale when its watcher is dead and its claude
# is dead or was never started: the prompt is put back to `pending` if it still
# says `running`, a note goes to the run's .err, an empty .json is removed, the
# lock is removed and a line with `recovered` in the exit column is logged. A
# lock whose claude.pid or watcher.pid is alive is never stale: the workspace
# is in progress and is skipped, whatever the prompt's status says (a live
# watcher with a dead claude is between claude's exit and release_lock). Known
# limitation: a dead PID reused by an unrelated process makes a lock look alive
# until that process exits; liveness is `kill -0`, no timeouts or other
# heuristics.
#
# SIGINT/SIGTERM/SIGHUP (tmux kill-session) during a run: TERM to claude's
# whole process group, KILL after $RELAY_STOP_GRACE seconds (default 15) and
# another 5 s to be reaped. Once claude is gone the prompt goes back to
# `pending` (note in the .err file), the lock is released and the run is logged
# with `interrupted` in the exit column. If claude survives even KILL, the
# prompt and the lock are left as they are and the exit column says
# `interrupted-alive`; the next start then waits for that claude.
#
# Each finished run also appends one line to <ws>/docs/status/LATEST, the file
# the planning side reads instead of polling (not written by --dry-run, nor
# for waiting / misnamed lines):
#
#   <iso time> <tab> <stem> <tab> <status> <tab> <branch> <tab> <commit>
#   <tab> <exit> <tab> <seconds>
#
# status is the prompt's front-matter status after the run (pending after an
# interrupt); branch is its `branch:` key or -; commit is the short hash of
# that branch in repos/<repo>, or - if there is none; exit is claude's exit
# code or `interrupted`.
#
# After each run a desktop notification names the prompt and its final
# status (done / blocked / failed), so the human can read the status file and
# ping the planning session instead of that session polling. macOS only
# (osascript); silently skipped elsewhere or with RELAY_NOTIFY=0.
#
# Needs bash, git, claude; jq is optional. macOS first (BSD date and stat),
# but nothing here is macOS-only.

set -uo pipefail

self=$0
while [ -L "$self" ]; do # installed as a symlink: find the real script
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
here=$(cd "$(dirname "$self")" && pwd)
root=$(dirname "$here")
relay_prompt=$root/plugin/bin/relay-prompt
config=${XDG_CONFIG_HOME:-$HOME/.config}/relay/workspaces
log=${XDG_STATE_HOME:-$HOME/.local/state}/relay/watch.log
session=relay

usage() { # usage [exit code]
  sed -n '4,5p' "$0" | sed 's/^# \{0,1\}//' >&2
  echo "config: $config (one absolute workspace path per line, # comments)" >&2
  exit "${1:-64}"
}

die() {
  echo "relay-watch: $*" >&2
  exit 1
}

version() {
  sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$root/plugin/.claude-plugin/plugin.json" 2>/dev/null | head -n 1
}

install() { # install [dir]: symlink the two commands into dir
  local dir=${1:-$HOME/.local/bin} src name target
  dir=${dir/#\~/$HOME}
  mkdir -p "$dir" || die "cannot create $dir"
  for src in "$here/relay-watch" "$relay_prompt"; do
    name=${src##*/}
    target=$dir/$name
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      die "$target exists and is not a symlink, not overwriting"
    fi
    ln -sf "$src" "$target" || die "cannot link $target"
    echo "$target -> $src"
  done
  case ":$PATH:" in
    *":${dir%/}:"*) ;;
    *) echo "relay-watch: $dir is not on PATH; add: export PATH=\"$dir:\$PATH\"" ;;
  esac
}

if [ "${1:-}" = install ]; then
  [ $# -le 2 ] || usage
  [ -x "$relay_prompt" ] || die "relay-prompt not found next to this script: $relay_prompt"
  install "${2:-}"
  exit 0
fi

sub="" sub_args=()
case ${1:-} in
  status | recover | restart) sub=$1; shift; sub_args=("$@"); set -- ;;
esac

once=0 dry_run=0 interval=60 use_tmux=0
mode=${RELAY_PERMISSION_MODE:-auto}
pass_through=()
while [ $# -gt 0 ]; do
  case $1 in
    --once) once=1; pass_through+=("$1"); shift ;;
    --dry-run) dry_run=1; pass_through+=("$1"); shift ;;
    --interval)
      [ $# -ge 2 ] || usage
      case $2 in '' | *[!0-9]*) die "--interval needs a whole number of seconds" ;; esac
      interval=$2; pass_through+=("$1" "$2"); shift 2 ;;
    --permission-mode)
      [ $# -ge 2 ] || usage
      [ -n "$2" ] || die "--permission-mode needs a value"
      mode=$2; pass_through+=("$1" "$2"); shift 2 ;;
    --tmux) use_tmux=1; shift ;;
    --version) echo "relay-watch $(version)"; exit 0 ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done

[ -x "$relay_prompt" ] || die "relay-prompt not found next to this script: $relay_prompt"
[ -f "$config" ] || { echo "relay-watch: no config file: $config" >&2; usage 1; }

if [ "$use_tmux" = 1 ]; then
  command -v tmux >/dev/null 2>&1 || die "tmux not installed"
  if tmux has-session -t "=$session" 2>/dev/null; then
    die "tmux session '$session' already exists; attach with: tmux attach -t $session"
  fi
  cmd=$(printf '%q ' "$here/relay-watch" ${pass_through[@]+"${pass_through[@]}"})
  tmux new-session -d -s "$session" -n watch "$cmd"
  echo "relay-watch running in tmux session '$session'; attach with: tmux attach -t $session"
  exit 0
fi

state_dir=$(dirname "$log")
mkdir -p "$state_dir"

now_iso() { date +%Y-%m-%dT%H:%M:%S%z; }
now_stamp() { date +%Y%m%d-%H%M%S; }

workspaces() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    line=${line/#\~/$HOME}
    line=${line%/}
    printf '%s\n' "$line"
  done <"$config"
}

log_line() { # log_line <ws> <file> <model> <exit> <seconds>
  local line
  line=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$(now_iso)" "$1" "$2" "$3" "$4" "$5" "$mode")
  printf '%s\n' "$line" >>"$log"
  printf '%s\n' "$line"
}

stop_grace=${RELAY_STOP_GRACE:-15}
case $stop_grace in '' | *[!0-9]*) die "RELAY_STOP_GRACE needs a whole number of seconds" ;; esac

# alive <pid>: running (a zombie that is not reaped yet does not count)
alive() {
  kill -0 "$1" 2>/dev/null || return 1
  case $(ps -o stat= -p "$1" 2>/dev/null) in Z*) return 1 ;; esac
  return 0
}

# wait_gone <pid> <seconds>: poll every 0.5 s; success once <pid> is gone
wait_gone() {
  local n=$(($2 * 2))
  while alive "$1"; do
    [ "$n" -gt 0 ] || return 1
    n=$((n - 1))
    sleep 0.5
  done
}

# remove_lock <dir>: the five files by name, then the directory
remove_lock() {
  local f
  for f in watcher.pid prompt run started claude.pid; do rm -f "$1/$f"; done
  rmdir "$1" 2>/dev/null
}

lock_dir="" current_file="" current_err=""
release_lock() {
  [ -n "$lock_dir" ] && remove_lock "$lock_dir"
  lock_dir=""
}

# A prompt left `running` would never be picked up again, and one left
# `pending` (claude exited before /relay:next claimed it — plugin missing,
# login expired, …) would be retried every pass forever. Either way the run
# did not finish on its own: mark it failed, with a note in its .err file.
fail_if_unfinished() { # fail_if_unfinished <file> <err file> <note>
  local status
  status=$("$relay_prompt" get "$1" status 2>/dev/null) || status=""
  case $status in running | pending) ;; *) return 1 ;; esac
  "$relay_prompt" set "$1" status failed
  echo "relay-watch $(now_iso): $3 with the prompt still '$status'; set to failed" >>"$2"
}

# Stopping the watcher is not the prompt's fault: an unfinished prompt goes
# back to `pending` so the next watcher start retries it.
current_ws="" current_model="" current_started="" child="" claude_pid="" sig=""
interrupted() {
  local status secs
  trap '' INT TERM HUP
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null
    wait "$child" 2>/dev/null
  fi
  if [ -n "$claude_pid" ]; then
    kill -TERM -- "-$claude_pid" 2>/dev/null
    if ! wait_gone "$claude_pid" "$stop_grace"; then
      kill -KILL -- "-$claude_pid" 2>/dev/null
      wait_gone "$claude_pid" 5
    fi
    if alive "$claude_pid"; then
      status=$("$relay_prompt" get "$current_file" status 2>/dev/null) || status=""
      echo "relay-watch $(now_iso): interrupted, but claude $claude_pid could not be stopped; prompt left '$status', lock kept" >>"$current_err"
      secs=$(( $(date +%s) - current_started ))
      log_line "$current_ws" "${current_file#"$current_ws"/}" "$current_model" interrupted-alive "$secs" >/dev/null
      exit 130
    fi
    wait "$claude_pid" 2>/dev/null
    claude_pid=""
  fi
  if [ -n "$current_file" ]; then
    status=$("$relay_prompt" get "$current_file" status 2>/dev/null) || status=""
    case $status in
      running | pending)
        "$relay_prompt" set "$current_file" status pending
        echo "relay-watch $(now_iso): relay-watch was interrupted with the prompt still '$status'; set to pending${sig:+ ($sig)}" >>"$current_err"
        ;;
    esac
    secs=$(( $(date +%s) - current_started ))
    write_latest "$current_ws" "$current_file" "$(basename "$current_file" .md)" interrupted "$secs"
    release_lock
    commit_run_log "$current_ws" "$(basename "$current_file" .md)"
    log_line "$current_ws" "${current_file#"$current_ws"/}" "$current_model" interrupted "$secs" >/dev/null
  fi
  release_lock
  exit 130
}
trap 'sig=SIGINT; interrupted' INT
trap 'sig=SIGTERM; interrupted' TERM
trap 'sig=SIGHUP; interrupted' HUP

# The run log is complete only once claude has exited, so the skill leaves
# docs/status/runs/ and docs/status/LATEST out of its own commit; both are
# committed here. Failure
# (not a git workspace, nothing to commit) is ignored.
commit_run_log() { # commit_run_log <ws> <stem>
  git -C "$1" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local paths=(docs/status/runs)
  [ -e "$1/docs/status/LATEST" ] && paths+=(docs/status/LATEST)
  git -C "$1" add -- "${paths[@]}" >/dev/null 2>&1 || return 0
  git -C "$1" commit -q -m "docs: run log $2" -- "${paths[@]}" >/dev/null 2>&1 || true
}

# One line per run for the planning side; created on first write, never
# truncated.
write_latest() { # write_latest <ws> <file> <stem> <exit> <seconds>
  local ws=$1 file=$2 status branch repo commit=- hash
  status=$("$relay_prompt" get "$file" status 2>/dev/null) || status=""
  branch=$("$relay_prompt" get "$file" branch 2>/dev/null) || branch=""
  repo=$("$relay_prompt" get "$file" repo 2>/dev/null) || repo=""
  if [ -n "$branch" ] && [ -n "$repo" ]; then
    hash=$(git -C "$ws/repos/$repo" rev-parse --short --verify -q "refs/heads/$branch" 2>/dev/null) && [ -n "$hash" ] && commit=$hash
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(now_iso)" "$3" "${status:--}" "${branch:--}" "$commit" "$4" "$5" \
    >>"$ws/docs/status/LATEST"
}

notify() { # notify <ws> <stem> <status>: desktop notification, best effort
  [ "${RELAY_NOTIFY:-1}" != 0 ] || return 0
  command -v osascript >/dev/null 2>&1 || return 0
  local title="relay: $3" text="$2 — ${1##*/}/docs/status"
  case $3 in blocked) text="$2 needs a decision — question at the top of its status file" ;; esac
  osascript -e "display notification \"$text\" with title \"$title\"" >/dev/null 2>&1 || true
}

run_one() { # run_one <ws> <prompt file>
  local ws=$1 file=$2 rel stem model runs stamp out err started exit_code secs
  rel=${file#"$ws"/}
  stem=${rel##*/}
  stem=${stem%.md}
  model=$("$relay_prompt" get "$file" model 2>/dev/null) || model=""
  [ -n "$model" ] || model=sonnet
  runs=$ws/docs/status/runs
  mkdir -p "$runs" || return

  if ! mkdir "$runs/.lock" 2>/dev/null; then
    echo "relay-watch: $ws is locked ($runs/.lock), skipping" >&2
    return
  fi
  lock_dir=$runs/.lock

  stamp=$(now_stamp)
  # A second run within the same second must not reuse (and truncate) the
  # files of the first, e.g. right after a recovery.
  while [ -e "$runs/$stem.$stamp.json" ] || [ -e "$runs/$stem.$stamp.err" ]; do
    sleep 1
    stamp=$(now_stamp)
  done
  out=$runs/$stem.$stamp.json
  err=$runs/$stem.$stamp.err
  started=$(date +%s)
  printf '%s\n' "$$" >"$lock_dir/watcher.pid"
  printf '%s\n' "$rel" >"$lock_dir/prompt"
  printf '%s\n' "$stem.$stamp" >"$lock_dir/run"
  now_iso >"$lock_dir/started"

  if [ "$dry_run" = 1 ]; then
    printf 'cd %q && claude -p %q --model %q --permission-mode %q --permission-prompts none --output-format json >%q 2>>%q\n' \
      "$ws" "/relay:next $rel" "$model" "$mode" "$out" "$err"
    release_lock
    log_line "$ws" "$rel" "$model" dry-run 0
    return
  fi

  current_file=$file current_err=$err current_ws=$ws current_model=$model current_started=$started
  # Background + wait, so a signal reaches the trap while claude is running.
  # Job control gives the background job its own process group; the subshell
  # execs claude, so its PID is claude's and the group id.
  set -m
  (
    cd "$ws" || exit 127
    exec claude -p "/relay:next $rel" --model "$model" \
      --permission-mode "$mode" --permission-prompts none \
      --output-format json
  ) </dev/null >"$out" 2>>"$err" &
  claude_pid=$!
  set +m
  printf '%s\n' "$claude_pid" >"$lock_dir/claude.pid"
  wait "$claude_pid"
  exit_code=$?
  claude_pid=""

  fail_if_unfinished "$file" "$err" "claude exited $exit_code"
  notify "$ws" "$stem" "$("$relay_prompt" get "$file" status 2>/dev/null || echo unknown)"
  current_file="" current_err=""
  secs=$(( $(date +%s) - started ))
  write_latest "$ws" "$file" "$stem" "$exit_code" "$secs"
  release_lock
  commit_run_log "$ws" "$stem"
  log_line "$ws" "$rel" "$model" "$exit_code" "$secs"
}

iso_to_epoch() { # iso_to_epoch <iso time>: epoch seconds, or nothing
  date -j -f %Y-%m-%dT%H:%M:%S%z "$1" +%s 2>/dev/null || date -d "$1" +%s 2>/dev/null
}

# lock_read <ws>: load the lock's owner files into lk_* (empty when absent)
lock_read() {
  local lock=$1/docs/status/runs/.lock
  lk_cpid="" lk_wpid="" lk_rel="" lk_run="" lk_started=""
  [ -f "$lock/claude.pid" ] && lk_cpid=$(<"$lock/claude.pid")
  [ -f "$lock/watcher.pid" ] && lk_wpid=$(<"$lock/watcher.pid")
  [ -f "$lock/prompt" ] && lk_rel=$(<"$lock/prompt")
  [ -f "$lock/run" ] && lk_run=$(<"$lock/run")
  [ -f "$lock/started" ] && lk_started=$(<"$lock/started")
  return 0
}

# lock_state <ws>: classify the lock, change nothing. Prints
#   none                      no lock
#   live                      claude is alive, or the watcher is (between
#                             claude's exit and release_lock)
#   setup                     no claude.pid yet, the watcher is alive
#   stale <reason>            claude dead / watcher dead / legacy lock, no owners
lock_state() {
  [ -d "$1/docs/status/runs/.lock" ] || { echo none; return 0; }
  lock_read "$1"
  if [ -n "$lk_cpid" ] && alive "$lk_cpid"; then echo live
  elif [ -n "$lk_wpid" ] && alive "$lk_wpid"; then
    if [ -z "$lk_cpid" ]; then echo setup; else echo live; fi
  elif [ -n "$lk_cpid" ]; then echo "stale claude $lk_cpid dead"
  elif [ -n "$lk_wpid" ]; then echo "stale watcher $lk_wpid dead"
  else echo "stale legacy lock, no owners"
  fi
}

# in_progress <ws>: the "not touching it" line for a live or setup lock
in_progress() {
  lock_read "$1"
  if [ -n "$lk_cpid" ] && alive "$lk_cpid"; then
    echo "relay-watch: $1: in progress, lock held by claude $lk_cpid (${lk_rel:--})" >&2
  else
    echo "relay-watch: $1: in progress, lock held by watcher $lk_wpid (${lk_rel:--})" >&2
  fi
}

# recover_stale <ws>: heal a lock left by a dead watcher/claude (rules in the
# header). Returns 1 when the workspace is in progress and must be skipped.
# With recover_dry=1 it only prints what it would do.
recover_dry=0
recover_stale() {
  local ws=$1 runs lock cpid rel run started p f status state
  local err="" stem now secs=0 t model="-" first="-" word prompts=()
  state=$(lock_state "$ws")
  case $state in
    none) return 0 ;;
    live | setup) in_progress "$ws"; return 1 ;;
  esac
  lock_read "$ws"
  cpid=$lk_cpid rel=$lk_rel run=$lk_run started=$lk_started
  runs=$ws/docs/status/runs
  lock=$runs/.lock

  # Stale. Which prompt(s) were running?
  if [ -n "$rel" ]; then
    prompts=("$ws/$rel")
  else
    for p in "$ws"/docs/plans/*.prompt-*.md; do
      [ -f "$p" ] && [ "$("$relay_prompt" get "$p" status 2>/dev/null)" = running ] && prompts+=("$p")
    done
  fi
  now=$(date +%s)
  if [ -n "$started" ] && t=$(iso_to_epoch "$started") && [ -n "$t" ]; then secs=$((now - t)); fi
  [ "$secs" -ge 0 ] || secs=0

  for p in ${prompts[@]+"${prompts[@]}"}; do
    stem=${p##*/}
    stem=${stem%.md}
    status=$("$relay_prompt" get "$p" status 2>/dev/null) || status=unknown
    word="recovered: watcher/claude died with the prompt '$status'"
    if [ "$status" = running ]; then
      if [ "$recover_dry" = 1 ]; then
        echo "would set ${p#"$ws"/} pending"
      else
        "$relay_prompt" set "$p" status pending
      fi
      word="$word; set to pending"
    fi
    if [ -n "$run" ]; then
      err=$runs/$run.err
    else
      err=""
      for f in "$runs/$stem".*.err; do [ -e "$f" ] && err=$f; done
      [ -n "$err" ] || err=$runs/$stem.$(now_stamp).err
    fi
    if [ "$recover_dry" = 1 ]; then
      [ -e "${err%.err}.json" ] && [ ! -s "${err%.err}.json" ] && echo "would remove empty ${err%.err}.json"
    else
      echo "relay-watch $(now_iso): $word" >>"$err"
      [ -s "${err%.err}.json" ] || rm -f "${err%.err}.json"
    fi
    if [ "$first" = - ]; then
      first=${p#"$ws"/}
      model=$("$relay_prompt" get "$p" model 2>/dev/null) || model=-
    fi
  done
  if [ "$recover_dry" = 1 ]; then
    echo "would remove lock $lock"
    return 0
  fi
  remove_lock "$lock"
  echo "relay-watch: $ws: recovered stale lock (claude ${cpid:--} dead)" >&2
  log_line "$ws" "$first" "${model:--}" recovered "$secs"
  return 0
}

# Log each waiting prompt at most once per 10 minutes; the last-logged time
# lives in a state file so a restart does not repeat the line.
note_waiting() { # note_waiting <ws>
  local ws=$1 seen=$state_dir/waiting.seen f after rel now last
  now=$(date +%s)
  while IFS=$'\t' read -r f after _; do
    [ -n "$f" ] || continue
    rel=${f#"$ws"/}
    last=$(awk -F'\t' -v k="$ws	$rel" '$2 "\t" $3 == k { print $1 }' "$seen" 2>/dev/null | tail -n 1)
    if [ -n "$last" ] && [ $((now - last)) -lt 600 ]; then continue; fi
    printf '%s\t%s\t%s\n' "$now" "$ws" "$rel" >>"$seen"
    line=$(printf '%s\twaiting\t%s\t%s\t%s' "$(now_iso)" "$ws" "$rel" "$after")
    printf '%s\n' "$line" >>"$log"
    printf '%s\n' "$line"
  done < <("$relay_prompt" waiting "$ws" 2>/dev/null)
}

# Log each misnamed prompt file once; a file renamed to a valid name is simply
# picked up by `next`. State: <ws><tab><rel> per line in misnamed.seen.
note_misnamed() { # note_misnamed <ws>
  local ws=$1 seen=$state_dir/misnamed.seen f reason rel line
  while IFS=$'\t' read -r f reason; do
    [ -n "$f" ] || continue
    rel=${f#"$ws"/}
    grep -qxF -- "$ws	$rel" "$seen" 2>/dev/null && continue
    printf '%s\t%s\n' "$ws" "$rel" >>"$seen"
    line=$(printf '%s\tmisnamed\t%s\t%s\t%s' "$(now_iso)" "$ws" "$rel" "$reason")
    printf '%s\n' "$line" >>"$log"
    printf '%s\n' "$line"
  done < <("$relay_prompt" lint "$ws" 2>/dev/null)
}

pass() {
  local ws file
  while IFS= read -r ws; do
    if [ ! -d "$ws/docs/plans" ]; then
      echo "relay-watch: not a workspace (no docs/plans): $ws" >&2
      continue
    fi
    if ! recover_stale "$ws"; then
      note_misnamed "$ws"
      continue
    fi
    if file=$("$relay_prompt" next "$ws" 2>/dev/null); then
      run_one "$ws" "$file"
    else
      note_waiting "$ws"
    fi
    note_misnamed "$ws"
  done < <(workspaces)
}

# --- status / recover / restart ---------------------------------------------

# select_ws [name…]: the configured workspaces, or only those a name matches
# (the full path, or a bare name that matches */name)
select_ws() {
  local a w found
  if [ $# -eq 0 ]; then workspaces; return; fi
  for a in "$@"; do
    a=${a/#\~/$HOME}
    a=${a%/}
    found=0
    while IFS= read -r w; do
      case $w in "$a" | */"$a") printf '%s\n' "$w"; found=1 ;; esac
    done < <(workspaces)
    [ "$found" = 1 ] || die "no workspace matching '$a' in $config"
  done
}

fmt_secs() { # fmt_secs <seconds>
  if [ "$1" -ge 3600 ]; then printf '%dh%02dm' $(($1 / 3600)) $(($1 % 3600 / 60))
  elif [ "$1" -ge 60 ]; then printf '%dm%02ds' $(($1 / 60)) $(($1 % 60))
  else printf '%ds' "$1"
  fi
}

tmux_has_session() { command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$session" 2>/dev/null; }

# watcher_alive: the pid in watcher.pid, if it is running
watcher_alive() {
  local pid
  [ -f "$state_dir/watcher.pid" ] || return 1
  pid=$(<"$state_dir/watcher.pid")
  [ -n "$pid" ] && alive "$pid" && printf '%s\n' "$pid"
}

# watcher_line: the `watcher:` line of status; returns 1 for a stale pid file
watcher_line() {
  local pid flags
  if [ ! -f "$state_dir/watcher.pid" ]; then echo "watcher: not running"; return 0; fi
  if pid=$(watcher_alive); then
    flags=$(tr '\n' ' ' <"$state_dir/watcher.flags" 2>/dev/null)
    flags=${flags% }
    echo "watcher: alive (pid $pid, flags: ${flags:-none})"
    return 0
  fi
  echo "STALE: watcher: dead (stale pid file, pid $(<"$state_dir/watcher.pid"))"
  return 1
}

# status_ws <ws>: one block; returns 1 when something in it is stale
status_ws() {
  local ws=$1 p st rel state bad=0 f after n name line running=() lw
  local cnt_pending=0 cnt_running=0 cnt_blocked=0 cnt_failed=0
  local nm_pending="" nm_running="" nm_blocked="" nm_failed=""
  echo "$ws"
  if [ ! -d "$ws/docs/plans" ]; then
    echo "  not a workspace (no docs/plans)"
    return 0
  fi
  lw=$("$relay_prompt" waiting "$ws" 2>/dev/null)
  for p in "$ws"/docs/plans/*.prompt-*.md; do
    [ -f "$p" ] || continue
    st=$("$relay_prompt" get "$p" status 2>/dev/null) || continue
    name=${p##*/}
    name=${name%.md}
    case $st in
      pending)
        after=$(printf '%s\n' "$lw" | awk -F'\t' -v f="$p" '$1 == f { print $2; exit }')
        [ -n "$after" ] && name="$name waiting $after"
        cnt_pending=$((cnt_pending + 1)); nm_pending="${nm_pending:+$nm_pending, }$name" ;;
      running) cnt_running=$((cnt_running + 1)); nm_running="${nm_running:+$nm_running, }$name"; running+=("$p") ;;
      blocked) cnt_blocked=$((cnt_blocked + 1)); nm_blocked="${nm_blocked:+$nm_blocked, }$name" ;;
      failed) cnt_failed=$((cnt_failed + 1)); nm_failed="${nm_failed:+$nm_failed, }$name" ;;
    esac
  done
  line="  queue:"
  for st in pending running blocked failed; do
    eval "n=\$cnt_$st name=\$nm_$st"
    line="$line$([ "$st" = pending ] || printf ,) $n $st${name:+ ($name)}"
  done
  echo "$line"

  state=$(lock_state "$ws")
  lock_read "$ws"
  rel=${lk_rel:+ on $lk_rel}
  case $state in
    none) echo "  lock: none" ;;
    live | setup)
      if [ -n "$lk_cpid" ] && alive "$lk_cpid"; then
        echo "  lock: claude $lk_cpid alive since ${lk_started:--}$rel"
      else
        echo "  lock: held by watcher $lk_wpid$rel"
      fi ;;
    stale*) echo "  lock: STALE: ${state#stale }$rel"; bad=1 ;;
  esac
  for p in ${running[@]+"${running[@]}"}; do
    rel=${p#"$ws"/}
    case $state in
      none) echo "  STALE: ${rel} is running but there is no lock"; bad=1 ;;
      live | setup)
        if [ -n "$lk_rel" ] && [ "$lk_rel" != "$rel" ]; then
          echo "  STALE: $rel is running but the lock is for $lk_rel"; bad=1
        fi ;;
    esac
  done

  line=$(awk -F'\t' -v w="$ws" '$2 == w { l = $0 } END { print l }' "$log" 2>/dev/null)
  if [ -n "$line" ]; then
    IFS=$'\t' read -r l_ts _ l_file _ l_exit l_secs _ <<<"$line"
    echo "  last: $l_file exit $l_exit ${l_secs}s $l_ts"
  else
    echo "  last: none"
  fi
  return "$bad"
}

cmd_status() {
  local list ws bad=0 last alive_pid=""
  list=$(select_ws "$@") || exit 1
  watcher_line || bad=1
  alive_pid=$(watcher_alive)
  if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux: not installed"
  elif tmux_has_session; then
    if [ -n "$alive_pid" ]; then echo "tmux: session '$session' present"
    else echo "STALE: tmux: session '$session' present but no live watcher"; bad=1; fi
  else
    echo "tmux: session '$session' absent"
  fi
  last=$(tail -n 1 "$log" 2>/dev/null | cut -f1)
  echo "log: $log${last:+ (last line $last)}"
  while IFS= read -r ws; do
    [ -n "$ws" ] || continue
    status_ws "$ws" || bad=1
  done <<<"$list"
  return "$bad"
}

cmd_recover() {
  local list ws state refused=0 did=0 dry=0 args=()
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) dry=1 ;;
      -*) usage ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  list=$(select_ws ${args[@]+"${args[@]}"}) || exit 1
  recover_dry=$dry
  while IFS= read -r ws; do
    [ -n "$ws" ] || continue
    state=$(lock_state "$ws")
    case $state in
      none) continue ;;
      live | setup)
        in_progress "$ws"
        echo "relay-watch: $ws: lock is live, not recovering" >&2
        refused=1; continue ;;
    esac
    did=1
    recover_stale "$ws"
  done <<<"$list"
  [ "$did" = 1 ] || [ "$refused" = 1 ] || echo "nothing to recover"
  return "$refused"
}

cmd_restart() {
  local force=0 list ws state pid="" t secs flags=() f _
  case ${1:-} in --force) force=1; shift ;; esac
  [ $# -eq 0 ] || usage
  command -v tmux >/dev/null 2>&1 || die "tmux not installed"
  list=$(workspaces)
  while IFS= read -r ws; do
    [ -n "$ws" ] || continue
    state=$(lock_state "$ws")
    lock_read "$ws"
    if [ "$state" = live ] && [ -n "$lk_cpid" ] && alive "$lk_cpid" && [ "$force" = 0 ]; then
      secs=0
      if [ -n "$lk_started" ] && t=$(iso_to_epoch "$lk_started") && [ -n "$t" ]; then secs=$(($(date +%s) - t)); fi
      [ "$secs" -ge 0 ] || secs=0
      die "refusing to restart: ${lk_rel:--} is running (claude $lk_cpid, $(fmt_secs "$secs")); --force stops it and puts the prompt back to pending"
    fi
  done <<<"$list"

  if [ -f "$state_dir/watcher.flags" ]; then
    while IFS= read -r f; do [ -n "$f" ] && flags+=("$f"); done <"$state_dir/watcher.flags"
  fi
  pid=$(watcher_alive)
  if [ -z "$pid" ] && tmux_has_session; then
    pid=$(tmux list-panes -t "=$session" -F '#{pane_pid}' 2>/dev/null | head -n 1)
    [ -n "$pid" ] && alive "$pid" || pid=""
  fi
  if [ -n "$pid" ]; then
    echo "stopping watcher $pid"
    kill -TERM "$pid" 2>/dev/null
    if ! wait_gone "$pid" $((stop_grace + 10)); then
      echo "relay-watch: watcher $pid did not stop within $((stop_grace + 10)) s, sending KILL" >&2
      kill -KILL "$pid" 2>/dev/null
      wait_gone "$pid" 5
    fi
  else
    echo "no watcher running; starting one"
  fi
  tmux_has_session && tmux kill-session -t "=$session"
  "$here/relay-watch" --tmux ${flags[@]+"${flags[@]}"} || exit $?
  for _ in 1 2 3 4 5 6; do
    watcher_alive >/dev/null && break
    sleep 0.5
  done
  watcher_line
}

if [ -n "$sub" ]; then
  "cmd_$sub" ${sub_args[@]+"${sub_args[@]}"}
  exit $?
fi

# Record this watcher for status / restart; the files go away with it, unless
# a newer watcher has already replaced them.
printf '%s\n' "$$" >"$state_dir/watcher.pid"
if [ ${#pass_through[@]} -gt 0 ]; then
  printf '%s\n' "${pass_through[@]}" >"$state_dir/watcher.flags"
else
  : >"$state_dir/watcher.flags"
fi
forget_watcher() {
  if [ "$(cat "$state_dir/watcher.pid" 2>/dev/null)" = "$$" ]; then
    rm -f "$state_dir/watcher.pid" "$state_dir/watcher.flags"
  fi
}
trap forget_watcher EXIT
if [ "$once" = 1 ]; then
  pass
  exit 0
fi

while :; do
  pass
  sleep "$interval" &
  child=$!
  wait "$child"
  child=""
done
