#!/usr/bin/env bash
# chirat-watch — poll workspaces for pending prompts and run them headless.
#
#   chirat-watch [--once] [--dry-run] [--interval N] [--permission-mode M] [--tmux] [--version]
#   chirat-watch install [dir] | status [ws…] | recover [--dry-run] [ws…] | restart [--force]
#   chirat-watch logs [-n N] [-f] [ws…] | tail [-f] [ws] | doctor [--online] [ws]
#
# Config: ~/.config/chirat/workspaces ($XDG_CONFIG_HOME honoured) — one absolute
# workspace path per line, `#` comments, leading `~` expanded.
#
# Every --interval seconds (default 60) each workspace is asked for its next
# pending prompt (`chirat-prompt next`). For a hit, chirat-watch takes the lock
# <ws>/.chirat/lock, runs from <ws>
#
#   claude -p "/chirat:next <file>" --model <model> --permission-mode <mode>
#          --permission-prompts none --output-format json
#
# with stdout in <ws>/.chirat/runs/<stem>.<YYYYMMDD-HHMMSS>.json and stderr
# appended to the matching .err, and marks the prompt `failed` if the run left
# it `running`. If <ws> is a git repository, the run log is then committed as
# `docs: run log <stem>` (.chirat/runs/, .chirat/LATEST and .chirat/status.log;
# never the lock; never pushed). One line per run goes to ~/.local/state/chirat/watch.log
# ($XDG_STATE_HOME honoured) and to stdout:
#
#   <iso time> <tab> <ws> <tab> <file> <tab> <model> <tab> <exit> <tab> <seconds>
#   <tab> <permission mode>
#
#   --once        single pass over all workspaces, then exit 0
#   --dry-run     print the claude command instead of running it, and write
#                 nothing at all: no lock, no runs/, no LATEST, no watch.log
#                 or *.seen line (the log line is printed only), no
#                 watcher.pid / watcher.flags, no state dir; a stale lock is
#                 reported as `recover --dry-run` would (`would set … pending`,
#                 `would remove lock …`) and left in place; the prompt shown
#                 as `would run` is the one a real pass would run — picked by
#                 `chirat-prompt next --as-pending <recovered…>`, which counts
#                 the prompts a recovery would re-queue as pending for that
#                 one call (no writes), so the preview and the real pass use
#                 the same queue and the same order
#   --interval N  seconds between passes (default 60)
#   --permission-mode M  claude permission mode, passed through verbatim;
#                 default `auto`, or $CHIRAT_PERMISSION_MODE (flag wins)
#   --tmux        start chirat-watch (with the remaining flags) in a detached
#                 tmux session named `chirat`; refuses if it already exists
#   --version     print the version and exit
#   install [dir] symlink chirat-watch and chirat-prompt into dir (default
#                 ~/.local/bin); refuses to replace anything that is not a
#                 symlink, hints at PATH if dir is not on it
#   status [ws…]  read-only report: watcher, tmux session, log, and per
#                 workspace the queue, the lock, the last run and a `next:`
#                 line (what the human does next); exit 1 when anything is
#                 STALE. A bare name (`aat`) matches `*/aat`
#   recover [--dry-run] [ws…]
#                 the stale-lock recovery below, on demand; --dry-run only
#                 prints what would be done; refuses a workspace whose lock
#                 is live
#   restart [--force]
#                 stop the watcher and start `chirat-watch --tmux` again with
#                 the same flags; refused while a claude is running unless
#                 --force (the prompt then goes back to `pending`)
#
#   logs [-n N] [-f] [ws…]
#                 last N (default 20) lines of watch.log as stored, only those
#                 of the given workspaces when any; -f follows
#   tail [-f] [ws]
#                 the run in progress for ws (the only workspace with a live
#                 lock when omitted): assistant text and tool calls, one line
#                 each, from the newest ~/.claude/projects/<ws, / as ->/*.jsonl
#                 modified since the lock's start; no tool output; times are UTC
#   doctor [--online] [ws]
#                 one ok / warn / FAIL line per check (claude, plugin, config,
#                 tmux, PATH, state dir, watcher); exit 1 on any FAIL; --online
#                 also asks claude for a reply (login expired shows up here).
#                 Without ws: one more line per registered workspace, naming
#                 its FAILs (`mvg: includeIf FAIL, identity FAIL`, or `mvg: ok`);
#                 these do not change the exit code. With ws (`~` allowed): that
#                 workspace's setup too — FAIL includeIf (in ~/.gitconfig or a
#                 file it includes; `gitdir:<ws>/`, path = <ws>/.gitconfig, ~
#                 and symlinks resolved), FAIL identity (git's user.email in the
#                 workspace and the first clone is the one in <ws>/.gitconfig),
#                 FAIL workspaces (not in the watcher's list), warn repos (no
#                 clone), warn default_branch (no such local branch in a clone),
#                 warn notify_open (unset or a placeholder). A FAIL prints the
#                 command that fixes it; a path without .chirat/ is a FAIL
#
# A running watcher records itself in the state dir (next to watch.log):
# watcher.pid and watcher.flags (its flags, one per line). Both are removed
# when it exits, unless a newer watcher has overwritten them. status and
# restart read them.
#
# A pending prompt with an unmet `after: <branch>` is skipped by `next`. When a
# pass finds nothing to run, each such prompt is logged as
#   <iso time> <tab> waiting <tab> <ws> <tab> <file> <tab> after=<branch>
# at most once per 10 minutes (state in <log dir>/waiting.seen).
#
# A pending or running file in <plans_dir>/ whose name does not match
# <topic>.prompt-<N><suffix>.md is never picked up (`chirat-prompt lint`). Each
# pass logs it, once per file ever (state in <log dir>/misnamed.seen):
#   <iso time> <tab> misnamed <tab> <ws> <tab> <file> <tab> <reason>
#
# Upgrading from relay: nothing is migrated automatically. A workspace with
# .relay/ and no .chirat/ is skipped and logged once (state in
# <log dir>/legacy.seen):
#   <iso time> <tab> legacy <tab> <ws> <tab> .relay/ <tab> <hint>
# status and doctor print the move-it command for that, for the old config
# dir and for RELAY_* variables (ignored); doctor also for old relay-watch /
# relay-prompt on PATH and a live tmux session `relay`.
#
# The lock directory records its owners: watcher.pid (chirat-watch), prompt
# (path relative to the workspace), run (<stem>.<stamp>, the basename of the
# .json/.err), started (iso time) and, once claude is up, claude.pid. claude
# runs in its own process group and is its leader, so claude.pid is also the
# process group id (pgid) of everything it starts. "claude is alive" means:
# the pid runs, or any process of that group still runs (`pgrep -g`, else
# `ps -o pgid= -A`; zombies do not count), or the group cannot be inspected
# at all (ps/pgrep failing) — unknown is never "gone". Before every
# `chirat-prompt next`, a lock is stale when its watcher is dead and its claude
# is dead or was never started: the prompt is put back to `pending` if it still
# says `running`, a note goes to the run's .err, an empty .json is removed, the
# lock is removed and a line with `recovered` in the exit column is logged. A
# lock whose claude or watcher.pid is alive is never stale: the workspace
# is in progress and is skipped, whatever the prompt's status says (a live
# watcher with a dead claude is between claude's exit and release_lock). Known
# limitation: a dead PID (or group id) reused by an unrelated process makes a
# lock look alive until that process exits; no timeouts or other heuristics.
#
# SIGINT/SIGTERM/SIGHUP (tmux kill-session) during a run: TERM to claude's
# whole process group, then wait for the *group* (not just claude) up to
# $CHIRAT_STOP_GRACE seconds (default 15), KILL the group, wait another 5 s.
# Only once no process of the group is left does the prompt go back to
# `pending` (note in the .err file), the lock is released and the run is
# logged with `interrupted` in the exit column. If anything of the group
# survives even KILL, or the group cannot be inspected, the prompt and the
# lock are left as they are and the exit column says `interrupted-alive`; the
# next start then waits for that group. `restart --force` applies the same
# rule when it has to KILL a watcher that did not stop by itself.
#
# A run that ends `done`, `blocked` or `failed` leaves the result in the
# prompt's front matter: `commit: <full sha>` is the head of its `branch:` in
# repos/<repo> (the skill writes it before the final status; the watcher
# fills or corrects it, and removes it when the branch does not exist, so a
# retry never keeps a stale value). `after:` of later prompts checks that
# commit once the branch is deleted. The prompt file is committed with the
# run log. When the prompt chosen for a run was let through by
# `after_mode: done`, the warning of `chirat-prompt check` is printed with
# the run and kept at the top of its .err.
#
# Each finished run also appends one line to <ws>/.chirat/LATEST, the file
# the planning side reads instead of polling (not written by --dry-run, nor
# for waiting / misnamed lines):
#
#   <iso time> <tab> <stem> <tab> <status> <tab> <branch> <tab> <commit>
#   <tab> <exit> <tab> <seconds>
#
# status is the prompt's front-matter status after the run (pending after an
# interrupt); branch is its `branch:` key or -; commit is the short hash of
# that branch in repos/<repo>, or - if there is none; exit is claude's exit
# code or `interrupted`.
#
# After each run a desktop notification (title `chirat: <status>`, subtitle the
# workspace name) says what to do next, so the human can read the status file
# and ping the planning session instead of that session polling:
#
#   done      <stem> done → review <status file>, merge <branch>
#   blocked   <stem> needs a decision → question at the top of <status file>
#   failed    <stem> failed → <status file>, runs/<stem>.<stamp>.err
#   other     <stem> <status> → <ws>/<status_dir>      (pending after an interrupt)
#
# <status file> is the newest <status_dir>/*<stem>*.md modified since the run
# started, relative to the workspace, or (no status file). macOS only;
# silently skipped elsewhere or with CHIRAT_NOTIFY=0. Sender, in order:
# terminal-notifier 3.x (brew install terminal-notifier; `-group chirat:<ws>`
# replaces the previous notification of the workspace); else osascript (shown
# as "Script Editor", click does nothing); else nothing. terminal-notifier
# needs its own notification permission, granted once by launching the bundle
# (`open "$(brew --prefix)/Cellar/terminal-notifier/<ver>/terminal-notifier.app"`,
# click Allow); until then every notification is dropped. `chirat-watch doctor
# --online` probes it. Its stderr is kept: appended to the run's .err under
# `notify: terminal-notifier said:`, a non-zero exit as `notify: terminal-notifier
# exit <n>`. Click action, exactly one of:
#   - CHIRAT_NOTIFY_OPEN=1 and a status file (done / blocked / failed):
#     `-execute "open '<status file>'; open '<notify_open>'"` (the second open
#     only when notify_open is set);
#   - else notify_open set in <ws>/.chirat/config (a URL or path, e.g.
#     claude://claude.ai/project/<uuid>): `-open <notify_open>`;
#   - else `-activate com.anthropic.claudefordesktop` (CHIRAT_NOTIFY_ACTIVATE
#     overrides the bundle id; empty = no click option).
# A value containing a quote is refused (warning). Under osascript the status
# file is opened at once instead. CHIRAT_NOTIFY_SENDER is removed: 3.x has no
# `-sender`.
#
# Everything chirat writes for itself lives in <ws>/.chirat/ (runs/, LATEST,
# status.log, lock/); everything a human reads stays under docs/. The optional
# <ws>/.chirat/config (`key=value` lines, `#` comments, no quotes; paths relative
# to the workspace root) sets plans_dir (default docs/plans), status_dir
# (default docs/status), default_branch (default main) and notify_open (see
# the notification above; default empty). Unknown keys are ignored. A run log
# still at docs/status/runs is reported by status and doctor (`warn:`) and is
# not migrated.
#
# Needs bash, git, claude; jq is optional. macOS first (BSD date and stat),
# but nothing here is macOS-only.

set -uo pipefail

self=$0
while [ -L "$self" ]; do # installed as a symlink: find the real script
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
here=$(cd "$(dirname "$self")" && pwd)
root=$(dirname "$here")
chirat_prompt=$root/plugin/bin/chirat-prompt
config=${XDG_CONFIG_HOME:-$HOME/.config}/chirat/workspaces
log=${XDG_STATE_HOME:-$HOME/.local/state}/chirat/watch.log
session=chirat

# Upgrading from relay: hints only, nothing is moved. legacy_global prints one
# line per relay-era leftover outside the workspaces (old config dir, RELAY_*
# variables, which are ignored).
legacy_global() {
  local base=${XDG_CONFIG_HOME:-$HOME/.config} v
  if [ -f "$base/relay/workspaces" ] && [ ! -f "$config" ]; then
    echo "legacy config $base/relay/workspaces — move it: mv $base/relay $base/chirat"
  fi
  while IFS= read -r v; do
    case $v in RELAY_*) echo "$v is set and ignored — use CHIRAT_${v#RELAY_}" ;; esac
  done < <(compgen -e)
}

usage() { # usage [exit code]
  sed -n '4,6p' "$0" | sed 's/^# \{0,1\}//' >&2
  echo "config: $config (one absolute workspace path per line, # comments)" >&2
  exit "${1:-64}"
}

die() {
  echo "chirat-watch: $*" >&2
  exit 1
}

version() {
  sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$root/plugin/.claude-plugin/plugin.json" 2>/dev/null | head -n 1
}

install() { # install [dir]: symlink the two commands into dir
  local dir=${1:-$HOME/.local/bin} src name target
  dir=${dir/#\~/$HOME}
  mkdir -p "$dir" || die "cannot create $dir"
  for src in "$here/chirat-watch" "$chirat_prompt"; do
    name=${src##*/}
    target=$dir/$name
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      die "$target exists and is not a symlink, not overwriting"
    fi
    ln -sf "$src" "$target" || die "cannot link $target"
    echo "$target -> $src"
  done
  case ":$PATH:" in
    *":${dir%/}:"*) ;;
    *) echo "chirat-watch: $dir is not on PATH; add: export PATH=\"$dir:\$PATH\"" ;;
  esac
}

if [ "${1:-}" = install ]; then
  [ $# -le 2 ] || usage
  [ -x "$chirat_prompt" ] || die "chirat-prompt not found next to this script: $chirat_prompt"
  install "${2:-}"
  exit 0
fi

sub="" sub_args=()
case ${1:-} in
  status | recover | restart | logs | tail | doctor) sub=$1; shift; sub_args=("$@"); set -- ;;
esac

once=0 dry_run=0 interval=60 use_tmux=0
mode=${CHIRAT_PERMISSION_MODE:-auto}
pass_through=()
while [ $# -gt 0 ]; do
  case $1 in
    --once) once=1; pass_through+=("$1"); shift ;;
    --dry-run) dry_run=1; pass_through+=("$1"); shift ;;
    --interval)
      [ $# -ge 2 ] || usage
      case $2 in '' | *[!0-9]*) die "--interval needs a whole number of seconds" ;; esac
      interval=$2; pass_through+=("$1" "$2"); shift 2 ;;
    --permission-mode)
      [ $# -ge 2 ] || usage
      [ -n "$2" ] || die "--permission-mode needs a value"
      mode=$2; pass_through+=("$1" "$2"); shift 2 ;;
    --tmux) use_tmux=1; shift ;;
    --version) echo "chirat-watch $(version)"; exit 0 ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done

# doctor reports these two itself
if [ "$sub" != doctor ]; then
  [ -x "$chirat_prompt" ] || die "chirat-prompt not found next to this script: $chirat_prompt"
  if [ ! -f "$config" ]; then
    echo "chirat-watch: no config file: $config" >&2
    legacy_global | sed 's/^/warn: /' >&2
    usage 1
  fi
fi

if [ "$use_tmux" = 1 ]; then
  command -v tmux >/dev/null 2>&1 || die "tmux not installed"
  if tmux has-session -t "=$session" 2>/dev/null; then
    die "tmux session '$session' already exists; attach with: tmux attach -t $session"
  fi
  cmd=$(printf '%q ' "$here/chirat-watch" ${pass_through[@]+"${pass_through[@]}"})
  tmux new-session -d -s "$session" -n watch "$cmd"
  echo "chirat-watch running in tmux session '$session'; attach with: tmux attach -t $session"
  exit 0
fi

state_dir=$(dirname "$log")
[ "$dry_run" = 1 ] || mkdir -p "$state_dir"

now_iso() { date +%Y-%m-%dT%H:%M:%S%z; }
now_stamp() { date +%Y%m%d-%H%M%S; }

workspaces() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    line=${line/#\~/$HOME}
    line=${line%/}
    printf '%s\n' "$line"
  done <"$config"
}

# chirat_config <ws> <key> <default>: value of <key> in <ws>/.chirat/config, else
# <default>. Identical copy lives in plugin/bin/chirat-prompt (that one stays standalone).
chirat_config() {
  local f=$1/.chirat/config line k v val=$3 n=0
  if [ -f "$f" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      n=$((n + 1))
      line=${line#"${line%%[![:space:]]*}"}
      case $line in '' | '#'*) continue ;; esac
      case $line in
        *=*) ;;
        *) echo "chirat: warning: $f:$n: not key=value, ignored" >&2; continue ;;
      esac
      k=${line%%=*}
      v=${line#*=}
      k=${k%"${k##*[![:space:]]}"}
      v=${v#"${v%%[![:space:]]*}"}
      v=${v%"${v##*[![:space:]]}"}
      if [ "$k" = "$2" ] && [ -n "$v" ]; then val=$v; fi
    done <"$f"
  fi
  printf '%s\n' "$val"
}

# legacy_msg <ws>: the move-it hint when a run log is still under docs/status
legacy_msg() {
  local cmd=""
  [ -e "$1/docs/status/runs" ] && cmd="git mv docs/status/runs .chirat/runs"
  if [ -e "$1/docs/status/LATEST" ]; then
    cmd="${cmd:+$cmd && }git mv docs/status/LATEST .chirat/LATEST"
  fi
  [ -z "$cmd" ] || printf 'legacy run log at docs/status/runs — move it: %s\n' "$cmd"
}

# legacy_ws_msg <ws>: the move-it hint when the workspace still has relay's
# .relay/ and no .chirat/; the watcher skips such a workspace
legacy_ws_msg() {
  [ -d "$1/.relay" ] && [ ! -e "$1/.chirat" ] || return 0
  if [ -d "$1/.relay/lock" ]; then
    echo "legacy .relay/ with .relay/lock/ — a run from the old watcher may still be live: check it first (relay-watch status), do not move it yet"
  else
    echo 'legacy .relay/ — move it: git mv .relay .chirat && sed -i.bak '"'"'s#^\.relay/#.chirat/#'"'"' .gitignore && rm .gitignore.bak'
  fi
}

log_line() { # log_line <ws> <file> <model> <exit> <seconds>
  local line
  line=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$(now_iso)" "$1" "$2" "$3" "$4" "$5" "$mode")
  [ "$dry_run" = 1 ] || printf '%s\n' "$line" >>"$log"
  printf '%s\n' "$line"
}

stop_grace=${CHIRAT_STOP_GRACE:-15}
case $stop_grace in '' | *[!0-9]*) die "CHIRAT_STOP_GRACE needs a whole number of seconds" ;; esac

# alive <pid>: running (a zombie that is not reaped yet does not count)
alive() {
  kill -0 "$1" 2>/dev/null || return 1
  case $(ps -o stat= -p "$1" 2>/dev/null) in Z*) return 1 ;; esac
  return 0
}

# wait_gone <pid> <seconds>: poll every 0.5 s; success once <pid> is gone
wait_gone() {
  local n=$(($2 * 2))
  while alive "$1"; do
    [ "$n" -gt 0 ] || return 1
    n=$((n - 1))
    sleep 0.5
  done
}

# group_alive <pgid>: 0 when the process group has a live member (zombies do
# not count), 1 when it has none, 2 when that cannot be told — pgrep and ps
# both failed (denied, missing). `pgrep -g` first (macOS and Linux), then
# `ps -o pid=,pgid=,stat= -A`; a producer that exits non-zero is an error, not
# an empty group (pgrep exits 1 for "no match", which is the empty group).
group_alive() {
  local out rc p st live=0 pserr=0
  case $1 in '' | 0 | *[!0-9]*) return 2 ;; esac
  if command -v pgrep >/dev/null 2>&1; then
    out=$(pgrep -g "$1" 2>/dev/null)
    rc=$?
    case $rc in
      0)
        for p in $out; do
          if st=$(ps -o stat= -p "$p" 2>/dev/null); then
            st=${st#"${st%%[![:space:]]*}"}
            case $st in '' | Z*) ;; *) live=1 ;; esac
          else
            pserr=1
          fi
        done
        [ "$live" = 0 ] || return 0
        [ "$pserr" = 1 ] || return 1 ;;
      1) return 1 ;;
    esac
  fi
  out=$(ps -o pid=,pgid=,stat= -A 2>/dev/null) || return 2
  [ -n "$out" ] || return 2
  if printf '%s\n' "$out" | awk -v g="$1" '$2 == g && $3 !~ /^Z/ { f = 1 } END { exit !f }'; then return 0; fi
  return 1
}

# claude_live <pid>: the claude of a lock counts as alive while its pid runs,
# while any process of its group does, or while the group cannot be inspected
claude_live() {
  alive "$1" && return 0
  group_alive "$1"
  [ $? -ne 1 ]
}

# wait_group_gone <pgid> <seconds>: poll every 0.5 s; 0 once no live member
# is left, 1 while one is after <seconds>, 2 when the group cannot be inspected
wait_group_gone() {
  local n=$(($2 * 2)) rc
  while :; do
    group_alive "$1"
    rc=$?
    case $rc in 1) return 0 ;; 2) return 2 ;; esac
    [ "$n" -gt 0 ] || return 1
    n=$((n - 1))
    sleep 0.5
  done
}

# stop_group <pgid>: TERM the group, wait up to $stop_grace, KILL it, wait 5 s;
# 0 when it is gone, 1 when something survived, 2 when that cannot be told
stop_group() {
  local rc
  kill -TERM -- "-$1" 2>/dev/null
  wait_group_gone "$1" "$stop_grace"
  rc=$?
  [ "$rc" = 0 ] && return 0
  kill -KILL -- "-$1" 2>/dev/null
  wait_group_gone "$1" 5
}

# remove_lock <dir>: the five files by name, then the directory
remove_lock() {
  local f
  for f in watcher.pid prompt run started claude.pid; do rm -f "$1/$f"; done
  rmdir "$1" 2>/dev/null
}

lock_dir="" current_file="" current_err=""
release_lock() {
  [ -n "$lock_dir" ] && remove_lock "$lock_dir"
  lock_dir=""
}

# A prompt left `running` would never be picked up again, and one left
# `pending` (claude exited before /chirat:next claimed it — plugin missing,
# login expired, …) would be retried every pass forever. Either way the run
# did not finish on its own: mark it failed, with a note in its .err file.
fail_if_unfinished() { # fail_if_unfinished <file> <err file> <note>
  local status
  status=$("$chirat_prompt" get "$1" status 2>/dev/null) || status=""
  case $status in running | pending) ;; *) return 1 ;; esac
  "$chirat_prompt" set "$1" status failed
  echo "chirat-watch $(now_iso): $3 with the prompt still '$status'; set to failed" >>"$2"
}

# Stopping the watcher is not the prompt's fault: an unfinished prompt goes
# back to `pending` so the next watcher start retries it.
current_ws="" current_model="" current_started="" child="" claude_pid="" sig=""
interrupted() {
  local status secs gone why
  trap '' INT TERM HUP
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null
    wait "$child" 2>/dev/null
  fi
  if [ -n "$claude_pid" ]; then
    stop_group "$claude_pid"
    gone=$?
    if [ "$gone" != 0 ]; then
      status=$("$chirat_prompt" get "$current_file" status 2>/dev/null) || status=""
      if [ "$gone" = 2 ]; then why="cannot inspect process group $claude_pid (ps and pgrep failed), so it may still be running"
      else why="claude's process group $claude_pid could not be stopped"; fi
      echo "chirat-watch $(now_iso): interrupted, but $why; prompt left '$status', lock kept" >>"$current_err"
      secs=$(( $(date +%s) - current_started ))
      log_line "$current_ws" "${current_file#"$current_ws"/}" "$current_model" interrupted-alive "$secs" >/dev/null
      exit 130
    fi
    wait "$claude_pid" 2>/dev/null
    claude_pid=""
  fi
  if [ -n "$current_file" ]; then
    status=$("$chirat_prompt" get "$current_file" status 2>/dev/null) || status=""
    case $status in
      running | pending)
        "$chirat_prompt" set "$current_file" status pending
        echo "chirat-watch $(now_iso): chirat-watch was interrupted with the prompt still '$status'; set to pending${sig:+ ($sig)}" >>"$current_err"
        ;;
    esac
    secs=$(( $(date +%s) - current_started ))
    write_latest "$current_ws" "$current_file" "$(basename "$current_file" .md)" interrupted "$secs"
    release_lock
    commit_run_log "$current_ws" "$(basename "$current_file" .md)" "${current_file#"$current_ws"/}"
    log_line "$current_ws" "${current_file#"$current_ws"/}" "$current_model" interrupted "$secs" >/dev/null
  fi
  release_lock
  exit 130
}
trap 'sig=SIGINT; interrupted' INT
trap 'sig=SIGTERM; interrupted' TERM
trap 'sig=SIGHUP; interrupted' HUP

# The run log is complete only once claude has exited, so the skill leaves
# the run log out of its own commit; .chirat/runs, .chirat/LATEST and
# .chirat/status.log are committed here, never .chirat/lock, plus the run's
# own prompt file when this run changed it (status, commit:) — no other
# prompt, no other edit. Failure (not a git workspace, nothing to commit) is
# ignored.
commit_run_log() { # commit_run_log <ws> <stem> [<prompt rel path>]
  git -C "$1" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local paths=() p
  for p in .chirat/runs .chirat/LATEST .chirat/status.log; do
    [ -e "$1/$p" ] && paths+=("$p")
  done
  if [ -n "${3:-}" ] && [ -n "$(git -C "$1" status --porcelain -- "$3" 2>/dev/null)" ]; then
    paths+=("$3")
  fi
  [ ${#paths[@]} -gt 0 ] || return 0
  git -C "$1" add -- "${paths[@]}" >/dev/null 2>&1 || return 0
  git -C "$1" commit -q -m "docs: run log $2" -- "${paths[@]}" >/dev/null 2>&1 || true
}

# branch_head <ws> <file>: the full sha of the prompt's branch in repos/<repo>;
# fails when the prompt names no repo/branch or the branch does not exist.
branch_head() {
  local branch repo
  branch=$("$chirat_prompt" get "$2" branch 2>/dev/null) || return 1
  repo=$("$chirat_prompt" get "$2" repo 2>/dev/null) || return 1
  [ -n "$branch" ] && [ -n "$repo" ] || return 1
  git -C "$1/repos/$repo" rev-parse --verify -q "refs/heads/$branch^{commit}" 2>/dev/null
}

# record_commit <ws> <file>: `commit:` is the branch head after the run — fill
# it in or correct it; remove it when there is no branch (a retry must not
# keep a stale result).
record_commit() {
  local head cur
  head=$(branch_head "$1" "$2") || head=""
  cur=$("$chirat_prompt" get "$2" commit 2>/dev/null) || cur=""
  if [ -n "$head" ]; then
    [ "$cur" = "$head" ] || "$chirat_prompt" set "$2" commit "$head"
  elif [ -n "$cur" ]; then
    "$chirat_prompt" unset "$2" commit
  fi
}

# One line per run for the planning side; created on first write, never
# truncated.
write_latest() { # write_latest <ws> <file> <stem> <exit> <seconds>
  local ws=$1 file=$2 status branch repo commit=- hash
  mkdir -p "$ws/.chirat"
  status=$("$chirat_prompt" get "$file" status 2>/dev/null) || status=""
  branch=$("$chirat_prompt" get "$file" branch 2>/dev/null) || branch=""
  repo=$("$chirat_prompt" get "$file" repo 2>/dev/null) || repo=""
  if hash=$(branch_head "$ws" "$file") && [ -n "$hash" ]; then
    commit=$(git -C "$ws/repos/$repo" rev-parse --short "$hash" 2>/dev/null) || commit=$hash
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(now_iso)" "$3" "${status:--}" "${branch:--}" "$commit" "$4" "$5" \
    >>"$ws/.chirat/LATEST"
}

# Portable to GNU and BSD userland: GNU flags first, BSD as fallback (GNU fails
# on BSD flags; BSD flags do not fail on GNU).
file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }

# status_file_for <ws> <stem> [min mtime]: the newest <status_dir>/*<stem>*.md
# (modified at or after min mtime), relative to <ws>; nothing when none.
# prompt-1 does not match prompt-16: a digit may not follow the stem.
status_file_for() {
  local ws=$1 stem=$2 min=${3:-0} f name t best="" best_t=0 sd
  sd=$(chirat_config "$ws" status_dir docs/status)
  for f in "$ws/$sd"/*"$stem"*.md; do
    [ -f "$f" ] || continue
    name=${f##*/}
    case ${name#*"$stem"} in [0-9]*) continue ;; esac
    t=$(file_mtime "$f") || continue
    [ "$t" -ge "$min" ] || continue
    if [ -z "$best" ] || [ "$t" -ge "$best_t" ]; then best=$f best_t=$t; fi
  done
  [ -n "$best" ] && printf '%s\n' "${best#"$ws"/}"
  return 0
}

notify() { # notify <ws> <stem> <status> <started epoch> <run>: desktop notification, best effort
  [ "${CHIRAT_NOTIFY:-1}" != 0 ] || return 0
  local ws=$1 stem=$2 st=$3 sf branch text title="chirat: $3" pd sd
  pd=$(chirat_config "$ws" plans_dir docs/plans)
  sd=$(chirat_config "$ws" status_dir docs/status)
  sf=$(status_file_for "$ws" "$stem" "${4:-0}")
  branch=$("$chirat_prompt" get "$ws/$pd/$stem.md" branch 2>/dev/null) || branch=""
  case $st in
    done) text="$stem done → review ${sf:-(no status file)}, merge ${branch:--}" ;;
    blocked) text="$stem needs a decision → question at the top of ${sf:-(no status file)}" ;;
    failed) text="$stem failed → ${sf:-(no status file)}, .chirat/runs/${5:-$stem.*}.err" ;;
    *) text="$stem $st → ${ws##*/}/$sd" ;;
  esac
  text=${text//\\/}
  text=${text//\"/}
  local ws_name=${ws##*/} cmd="" url q="'" open_file="" tn=0 errf="" rc=0 tnerr
  local activate=${CHIRAT_NOTIFY_ACTIVATE-com.anthropic.claudefordesktop}
  command -v terminal-notifier >/dev/null 2>&1 && tn=1
  [ -z "${5:-}" ] || errf="$ws/.chirat/runs/$5.err"
  if [ "${CHIRAT_NOTIFY_OPEN:-0}" = 1 ] && [ -n "$sf" ]; then
    case $st in done | blocked | failed) open_file="$ws/$sf" ;; esac
  fi
  url=$(chirat_config "$ws" notify_open "")
  case $url in
    *"$q"*) echo "chirat: warning: notify_open contains a quote, ignored" >&2; url="" ;;
  esac
  if [ "$tn" = 1 ]; then
    if [ -n "$open_file" ]; then
      case $open_file in
        *"$q"*) echo "chirat: warning: notify: $open_file contains a quote, click will not open it" >&2 ;;
        *) cmd="open '$open_file'" ;;
      esac
    fi
    local args=(-title "$title" -subtitle "$ws_name" -message "$text" -group "chirat:$ws_name")
    if [ -n "$cmd" ]; then
      [ -z "$url" ] || cmd="$cmd; open '$url'"
      args+=(-execute "$cmd")
    elif [ -n "$url" ]; then args+=(-open "$url")
    elif [ -n "$activate" ]; then args+=(-activate "$activate"); fi
    tnerr=$(terminal-notifier "${args[@]}" 2>&1 >/dev/null) || rc=$?
    if [ -n "$errf" ] && { [ -n "$tnerr" ] || [ "$rc" != 0 ]; }; then
      {
        [ -z "$tnerr" ] || printf 'notify: terminal-notifier said:\n%s\n' "$tnerr"
        [ "$rc" = 0 ] || printf 'notify: terminal-notifier exit %s\n' "$rc"
      } >>"$errf" 2>/dev/null || true
    fi
  else
    if command -v osascript >/dev/null 2>&1; then
      osascript -e "display notification \"$text\" with title \"$title\" subtitle \"$ws_name\"" >/dev/null 2>&1 || true
    fi
    [ -z "$open_file" ] || open "$open_file" >/dev/null 2>&1 || true
  fi
}

run_one() { # run_one <ws> <prompt file>
  local ws=$1 file=$2 rel stem model runs stamp out err started exit_code secs
  rel=${file#"$ws"/}
  stem=${rel##*/}
  stem=${stem%.md}
  model=$("$chirat_prompt" get "$file" model 2>/dev/null) || model=""
  [ -n "$model" ] || model=sonnet
  runs=$ws/.chirat/runs

  if [ "$dry_run" = 1 ]; then
    # Nothing is created, not even the lock: a lock that is there (and was
    # not just reported as stale) means a run is in progress.
    if [ -d "$ws/.chirat/lock" ] && [ "$dry_recovered" = 0 ]; then
      echo "chirat-watch: $ws is locked ($ws/.chirat/lock), skipping" >&2
      return
    fi
    stamp=$(now_stamp)
    printf 'cd %q && claude -p %q --model %q --permission-mode %q --permission-prompts none --output-format json >%q 2>>%q\n' \
      "$ws" "/chirat:next $rel" "$model" "$mode" "$runs/$stem.$stamp.json" "$runs/$stem.$stamp.err"
    log_line "$ws" "$rel" "$model" dry-run 0
    return
  fi

  mkdir -p "$runs" || return
  if ! mkdir "$ws/.chirat/lock" 2>/dev/null; then
    echo "chirat-watch: $ws is locked ($ws/.chirat/lock), skipping" >&2
    return
  fi
  lock_dir=$ws/.chirat/lock

  stamp=$(now_stamp)
  # A second run within the same second must not reuse (and truncate) the
  # files of the first, e.g. right after a recovery.
  while [ -e "$runs/$stem.$stamp.json" ] || [ -e "$runs/$stem.$stamp.err" ]; do
    sleep 1
    stamp=$(now_stamp)
  done
  out=$runs/$stem.$stamp.json
  err=$runs/$stem.$stamp.err
  started=$(date +%s)
  printf '%s\n' "$$" >"$lock_dir/watcher.pid"
  printf '%s\n' "$rel" >"$lock_dir/prompt"
  printf '%s\n' "$stem.$stamp" >"$lock_dir/run"
  now_iso >"$lock_dir/started"
  [ -z "$select_warn" ] || printf '%s\n' "$select_warn" >>"$err"

  current_file=$file current_err=$err current_ws=$ws current_model=$model current_started=$started
  # Background + wait, so a signal reaches the trap while claude is running.
  # Job control gives the background job its own process group; the subshell
  # execs claude, so its PID is claude's and the group id.
  set -m
  (
    cd "$ws" || exit 127
    exec claude -p "/chirat:next $rel" --model "$model" \
      --permission-mode "$mode" --permission-prompts none \
      --output-format json
  ) </dev/null >"$out" 2>>"$err" &
  claude_pid=$!
  set +m
  printf '%s\n' "$claude_pid" >"$lock_dir/claude.pid"
  wait "$claude_pid"
  exit_code=$?
  claude_pid=""

  fail_if_unfinished "$file" "$err" "claude exited $exit_code"
  case $("$chirat_prompt" get "$file" status 2>/dev/null) in done | blocked | failed) record_commit "$ws" "$file" ;; esac
  notify "$ws" "$stem" "$("$chirat_prompt" get "$file" status 2>/dev/null || echo unknown)" "$started" "$stem.$stamp"
  current_file="" current_err=""
  secs=$(( $(date +%s) - started ))
  write_latest "$ws" "$file" "$stem" "$exit_code" "$secs"
  release_lock
  commit_run_log "$ws" "$stem" "$rel"
  log_line "$ws" "$rel" "$model" "$exit_code" "$secs"
}

iso_to_epoch() { # iso_to_epoch <iso time>: epoch seconds, or nothing
  date -j -f %Y-%m-%dT%H:%M:%S%z "$1" +%s 2>/dev/null || date -d "$1" +%s 2>/dev/null
}

# lock_read <ws>: load the lock's owner files into lk_* (empty when absent)
lock_read() {
  local lock=$1/.chirat/lock
  lk_cpid="" lk_wpid="" lk_rel="" lk_run="" lk_started=""
  [ -f "$lock/claude.pid" ] && lk_cpid=$(<"$lock/claude.pid")
  [ -f "$lock/watcher.pid" ] && lk_wpid=$(<"$lock/watcher.pid")
  [ -f "$lock/prompt" ] && lk_rel=$(<"$lock/prompt")
  [ -f "$lock/run" ] && lk_run=$(<"$lock/run")
  [ -f "$lock/started" ] && lk_started=$(<"$lock/started")
  return 0
}

# lock_state <ws>: classify the lock, change nothing. Prints
#   none                      no lock
#   live                      claude is alive, or the watcher is (between
#                             claude's exit and release_lock)
#   setup                     no claude.pid yet, the watcher is alive
#   stale <reason>            claude dead / watcher dead / legacy lock, no owners
lock_state() {
  [ -d "$1/.chirat/lock" ] || { echo none; return 0; }
  lock_read "$1"
  if [ -n "$lk_cpid" ] && claude_live "$lk_cpid"; then echo live
  elif [ -n "$lk_wpid" ] && alive "$lk_wpid"; then
    if [ -z "$lk_cpid" ]; then echo setup; else echo live; fi
  elif [ -n "$lk_cpid" ]; then echo "stale claude $lk_cpid dead"
  elif [ -n "$lk_wpid" ]; then echo "stale watcher $lk_wpid dead"
  else echo "stale legacy lock, no owners"
  fi
}

# in_progress <ws>: the "not touching it" line for a live or setup lock
in_progress() {
  lock_read "$1"
  if [ -n "$lk_cpid" ] && claude_live "$lk_cpid"; then
    echo "chirat-watch: $1: in progress, lock held by claude $lk_cpid (${lk_rel:--})" >&2
  else
    echo "chirat-watch: $1: in progress, lock held by watcher $lk_wpid (${lk_rel:--})" >&2
  fi
}

# recover_stale <ws>: heal a lock left by a dead watcher/claude (rules in the
# header). Returns 1 when the workspace is in progress and must be skipped.
# With recover_dry=1 it only prints what it would do and sets dry_recovered=1
# and dry_recovered_files (the prompts it would put back to pending, if any).
recover_dry=0 dry_recovered=0 dry_recovered_files=() select_warn=""
recover_stale() {
  local ws=$1 runs lock cpid rel run started p f status state pd
  local err="" stem now secs=0 t model="-" first="-" word prompts=()
  state=$(lock_state "$ws")
  case $state in
    none) return 0 ;;
    live | setup) in_progress "$ws"; return 1 ;;
  esac
  lock_read "$ws"
  cpid=$lk_cpid rel=$lk_rel run=$lk_run started=$lk_started
  runs=$ws/.chirat/runs
  lock=$ws/.chirat/lock
  pd=$(chirat_config "$ws" plans_dir docs/plans)

  # Stale. Which prompt(s) were running?
  if [ -n "$rel" ]; then
    prompts=("$ws/$rel")
  else
    for p in "$ws/$pd"/*.prompt-*.md; do
      [ -f "$p" ] && [ "$("$chirat_prompt" get "$p" status 2>/dev/null)" = running ] && prompts+=("$p")
    done
  fi
  now=$(date +%s)
  if [ -n "$started" ] && t=$(iso_to_epoch "$started") && [ -n "$t" ]; then secs=$((now - t)); fi
  [ "$secs" -ge 0 ] || secs=0

  for p in ${prompts[@]+"${prompts[@]}"}; do
    stem=${p##*/}
    stem=${stem%.md}
    status=$("$chirat_prompt" get "$p" status 2>/dev/null) || status=unknown
    word="recovered: watcher/claude died with the prompt '$status'"
    if [ "$status" = running ]; then
      if [ "$recover_dry" = 1 ]; then
        echo "would set ${p#"$ws"/} pending"
        dry_recovered_files+=("$p")
      else
        "$chirat_prompt" set "$p" status pending
      fi
      word="$word; set to pending"
    fi
    if [ -n "$run" ]; then
      err=$runs/$run.err
    else
      err=""
      for f in "$runs/$stem".*.err; do [ -e "$f" ] && err=$f; done
      [ -n "$err" ] || err=$runs/$stem.$(now_stamp).err
    fi
    if [ "$recover_dry" = 1 ]; then
      [ -e "${err%.err}.json" ] && [ ! -s "${err%.err}.json" ] && echo "would remove empty ${err%.err}.json"
    else
      echo "chirat-watch $(now_iso): $word" >>"$err"
      [ -s "${err%.err}.json" ] || rm -f "${err%.err}.json"
    fi
    if [ "$first" = - ]; then
      first=${p#"$ws"/}
      model=$("$chirat_prompt" get "$p" model 2>/dev/null) || model=-
    fi
  done
  if [ "$recover_dry" = 1 ]; then
    echo "would remove lock $lock"
    dry_recovered=1
    return 0
  fi
  remove_lock "$lock"
  echo "chirat-watch: $ws: recovered stale lock (claude ${cpid:--} dead)" >&2
  log_line "$ws" "$first" "${model:--}" recovered "$secs"
  return 0
}

# Log each waiting prompt at most once per 10 minutes; the last-logged time
# lives in a state file so a restart does not repeat the line.
note_waiting() { # note_waiting <ws>
  local ws=$1 seen=$state_dir/waiting.seen f after rel now last
  now=$(date +%s)
  while IFS=$'\t' read -r f after _; do
    [ -n "$f" ] || continue
    rel=${f#"$ws"/}
    last=$(awk -F'\t' -v k="$ws	$rel" '$2 "\t" $3 == k { print $1 }' "$seen" 2>/dev/null | tail -n 1)
    if [ -n "$last" ] && [ $((now - last)) -lt 600 ]; then continue; fi
    [ "$dry_run" = 1 ] || printf '%s\t%s\t%s\n' "$now" "$ws" "$rel" >>"$seen"
    line=$(printf '%s\twaiting\t%s\t%s\t%s' "$(now_iso)" "$ws" "$rel" "$after")
    [ "$dry_run" = 1 ] || printf '%s\n' "$line" >>"$log"
    printf '%s\n' "$line"
  done < <("$chirat_prompt" waiting "$ws" 2>/dev/null)
}

# Log each misnamed prompt file once; a file renamed to a valid name is simply
# picked up by `next`. State: <ws><tab><rel> per line in misnamed.seen.
note_misnamed() { # note_misnamed <ws>
  local ws=$1 seen=$state_dir/misnamed.seen f reason rel line
  while IFS=$'\t' read -r f reason; do
    [ -n "$f" ] || continue
    rel=${f#"$ws"/}
    grep -qxF -- "$ws	$rel" "$seen" 2>/dev/null && continue
    [ "$dry_run" = 1 ] || printf '%s\t%s\n' "$ws" "$rel" >>"$seen"
    line=$(printf '%s\tmisnamed\t%s\t%s\t%s' "$(now_iso)" "$ws" "$rel" "$reason")
    [ "$dry_run" = 1 ] || printf '%s\n' "$line" >>"$log"
    printf '%s\n' "$line"
  done < <("$chirat_prompt" lint "$ws" 2>/dev/null)
}

# Log a relay-era workspace once; it is skipped until .relay/ is moved.
# State: <ws> per line in legacy.seen.
note_legacy() { # note_legacy <ws> <message>
  local seen=$state_dir/legacy.seen line
  grep -qxF -- "$1" "$seen" 2>/dev/null && return 0
  [ "$dry_run" = 1 ] || printf '%s\n' "$1" >>"$seen"
  line=$(printf '%s\tlegacy\t%s\t.relay/\t%s' "$(now_iso)" "$1" "$2")
  [ "$dry_run" = 1 ] || printf '%s\n' "$line" >>"$log"
  printf '%s\n' "$line"
}

pass() {
  local ws file pd lm
  while IFS= read -r ws; do
    lm=$(legacy_ws_msg "$ws")
    if [ -n "$lm" ]; then
      note_legacy "$ws" "$lm"
      continue
    fi
    pd=$(chirat_config "$ws" plans_dir docs/plans)
    if [ ! -d "$ws/$pd" ]; then
      echo "chirat-watch: not a workspace (no $pd): $ws" >&2
      continue
    fi
    recover_dry=$dry_run dry_recovered=0 dry_recovered_files=()
    if ! recover_stale "$ws"; then
      note_misnamed "$ws"
      continue
    fi
    # Under --dry-run the prompts a recovery would re-queue are still
    # `running` on disk; `next --as-pending` counts them as pending for this
    # one call, so the preview picks from the same queue, in the same order,
    # as the real pass does after recovering them.
    if [ "$dry_run" = 1 ] && [ ${#dry_recovered_files[@]} -gt 0 ]; then
      file=$("$chirat_prompt" next "$ws" --as-pending "${dry_recovered_files[@]}" 2>/dev/null)
    else
      file=$("$chirat_prompt" next "$ws" 2>/dev/null)
    fi
    if [ -n "$file" ]; then
      # `next` is quiet; the chosen prompt's own warning (`after_mode: done`
      # let it through) must be seen: printed here, kept in the run's .err.
      select_warn=$("$chirat_prompt" check "$ws" "$file" 2>&1 >/dev/null) || select_warn=""
      [ -z "$select_warn" ] || printf '%s\n' "$select_warn"
      run_one "$ws" "$file"
      select_warn=""
    else
      note_waiting "$ws"
    fi
    note_misnamed "$ws"
  done < <(workspaces)
}

# --- status / recover / restart ---------------------------------------------

# select_ws [name…]: the configured workspaces, or only those a name matches
# (the full path, or a bare name that matches */name)
select_ws() {
  local a w found
  if [ $# -eq 0 ]; then workspaces; return; fi
  for a in "$@"; do
    a=${a/#\~/$HOME}
    a=${a%/}
    found=0
    while IFS= read -r w; do
      case $w in "$a" | */"$a") printf '%s\n' "$w"; found=1 ;; esac
    done < <(workspaces)
    [ "$found" = 1 ] || die "no workspace matching '$a' in $config"
  done
}

fmt_secs() { # fmt_secs <seconds>
  if [ "$1" -ge 3600 ]; then printf '%dh%02dm' $(($1 / 3600)) $(($1 % 3600 / 60))
  elif [ "$1" -ge 60 ]; then printf '%dm%02ds' $(($1 / 60)) $(($1 % 60))
  else printf '%ds' "$1"
  fi
}

tmux_has_session() { command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$session" 2>/dev/null; }

# watcher_alive: the pid in watcher.pid, if it is running
watcher_alive() {
  local pid
  [ -f "$state_dir/watcher.pid" ] || return 1
  pid=$(<"$state_dir/watcher.pid")
  [ -n "$pid" ] && alive "$pid" && printf '%s\n' "$pid"
}

# watcher_line: the `watcher:` line of status; returns 1 for a stale pid file
# tn_app_path: the terminal-notifier.app bundle behind the command on PATH
# (symlinks followed); a Cellar template when it cannot be derived. Used by
# doctor, and the README gives the same expression.
tn_app_path() {
  local p dir
  p=$(command -v terminal-notifier) || return 1
  while [ -L "$p" ]; do
    dir=$(readlink "$p")
    case $dir in /*) p=$dir ;; *) p=$(dirname "$p")/$dir ;; esac
  done
  case $p in
    *.app/*) printf '%s\n' "${p%%.app/*}.app" ;;
    *) printf '%s\n' "$(brew --prefix 2>/dev/null || echo /opt/homebrew)/Cellar/terminal-notifier/<ver>/terminal-notifier.app" ;;
  esac
}

watcher_line() {
  local pid flags
  if [ ! -f "$state_dir/watcher.pid" ]; then echo "watcher: not running"; return 0; fi
  if pid=$(watcher_alive); then
    flags=$(tr '\n' ' ' <"$state_dir/watcher.flags" 2>/dev/null)
    flags=${flags% }
    echo "watcher: alive (pid $pid, flags: ${flags:-none})"
    return 0
  fi
  echo "STALE: watcher: dead (stale pid file, pid $(<"$state_dir/watcher.pid"))"
  return 1
}

# unmerged <ws> <prompt file>: success when the prompt's branch exists in
# repos/<repo> and is not yet in the default branch (a deleted branch counts as merged)
unmerged() {
  local r b repo db
  db=$(chirat_config "$1" default_branch main)
  b=$("$chirat_prompt" get "$2" branch 2>/dev/null) || return 1
  repo=$("$chirat_prompt" get "$2" repo 2>/dev/null) || return 1
  r=$1/repos/$repo
  [ -n "$b" ] && [ -n "$repo" ] || return 1
  git -C "$r" rev-parse --verify -q "refs/heads/$db" >/dev/null 2>&1 || return 1
  git -C "$r" rev-parse --verify -q "refs/heads/$b" >/dev/null 2>&1 || return 1
  ! git -C "$r" merge-base --is-ancestor "refs/heads/$b" "refs/heads/$db" 2>/dev/null
}

# next_line <ws> <waiting lines> <done> <blocked> <failed> <running> <n pending>
# The last four lists are newline-separated prompt files; prints the
# `next:` line(s) of status.
next_line() {
  local ws=$1 lw=$2 p stem sf br rel t mt out="" rl
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    unmerged "$ws" "$p" || continue
    stem=${p##*/}
    stem=${stem%.md}
    sf=$(status_file_for "$ws" "$stem")
    mt=0
    [ -n "$sf" ] && mt=$(file_mtime "$ws/$sf")
    out="$out$mt	$p
"
  done <<<"$3"
  if [ -n "$out" ]; then
    while IFS=$'\t' read -r mt p; do
      [ -n "$p" ] || continue
      stem=${p##*/}
      stem=${stem%.md}
      br=$("$chirat_prompt" get "$p" branch)
      sf=$(status_file_for "$ws" "$stem")
      rl=$(printf '%s\n' "$lw" | awk -F'\t' -v b="after=$br" '$2 == b { n = split($1, a, "/"); s = a[n]; sub(/\.md$/, "", s); printf "%s%s", (c++ ? ", " : ""), s }')
      echo "  next: review $stem ($br, ${sf:-(no status file)}), then merge; releases ${rl:-nothing}"
    done < <(printf '%s' "$out" | sort -n)
    return 0
  fi
  p=$(printf '%s\n' "$4" | sed -n 1p)
  if [ -n "$p" ]; then
    stem=${p##*/}; stem=${stem%.md}
    echo "  next: answer $stem ($(status_file_for "$ws" "$stem" || true))"
    return 0
  fi
  p=$(printf '%s\n' "$5" | sed -n 1p)
  if [ -n "$p" ]; then
    stem=${p##*/}; stem=${stem%.md}
    echo "  next: look at $stem ($(status_file_for "$ws" "$stem" || true))"
    return 0
  fi
  p=$(printf '%s\n' "$6" | sed -n 1p)
  if [ -n "$p" ]; then
    stem=${p##*/}; stem=${stem%.md}
    rel=${p#"$ws"/}
    lock_read "$ws"
    t=-
    [ "$lk_rel" = "$rel" ] && [ -n "$lk_started" ] && t=$lk_started
    echo "  next: wait ($stem running since $t)"
    return 0
  fi
  if [ "${7:-0}" -gt 0 ]; then
    echo "  next: wait ($7 pending)"
    return 0
  fi
  echo "  next: queue empty"
}

# status_ws <ws>: one block; returns 1 when something in it is stale
status_ws() {
  local ws=$1 p st rel state bad=0 f after n name line running=() lw pd lm
  local l_done="" l_blocked="" l_failed="" l_running=""
  local cnt_pending=0 cnt_running=0 cnt_blocked=0 cnt_failed=0
  local nm_pending="" nm_running="" nm_blocked="" nm_failed=""
  echo "$ws"
  lm=$(legacy_ws_msg "$ws")
  [ -z "$lm" ] || echo "  warn: $lm"
  pd=$(chirat_config "$ws" plans_dir docs/plans)
  if [ ! -d "$ws/$pd" ]; then
    echo "  not a workspace (no $pd)"
    return 0
  fi
  lm=$(legacy_msg "$ws")
  [ -z "$lm" ] || echo "  warn: $lm"
  lw=$("$chirat_prompt" waiting "$ws" 2>/dev/null)
  for p in "$ws/$pd"/*.prompt-*.md; do
    [ -f "$p" ] || continue
    st=$("$chirat_prompt" get "$p" status 2>/dev/null) || continue
    name=${p##*/}
    name=${name%.md}
    case $st in
      pending)
        after=$(printf '%s\n' "$lw" | awk -F'\t' -v f="$p" '$1 == f { print $2; exit }')
        [ -n "$after" ] && name="$name waiting $after"
        cnt_pending=$((cnt_pending + 1)); nm_pending="${nm_pending:+$nm_pending, }$name" ;;
      running) cnt_running=$((cnt_running + 1)); nm_running="${nm_running:+$nm_running, }$name"; running+=("$p"); l_running="$l_running$p
" ;;
      blocked) cnt_blocked=$((cnt_blocked + 1)); nm_blocked="${nm_blocked:+$nm_blocked, }$name"; l_blocked="$l_blocked$p
" ;;
      failed) cnt_failed=$((cnt_failed + 1)); nm_failed="${nm_failed:+$nm_failed, }$name"; l_failed="$l_failed$p
" ;;
      done) l_done="$l_done$p
" ;;
    esac
  done
  line="  queue:"
  for st in pending running blocked failed; do
    eval "n=\$cnt_$st name=\$nm_$st"
    line="$line$([ "$st" = pending ] || printf ,) $n $st${name:+ ($name)}"
  done
  echo "$line"
  echo "  notify: CHIRAT_NOTIFY=${CHIRAT_NOTIFY:-1} CHIRAT_NOTIFY_OPEN=${CHIRAT_NOTIFY_OPEN:-0} notify_open=$(chirat_config "$ws" notify_open "") (this shell's environment)"

  state=$(lock_state "$ws")
  lock_read "$ws"
  rel=${lk_rel:+ on $lk_rel}
  case $state in
    none) echo "  lock: none" ;;
    live | setup)
      if [ -n "$lk_cpid" ] && claude_live "$lk_cpid"; then
        echo "  lock: claude $lk_cpid alive since ${lk_started:--}$rel"
      else
        echo "  lock: held by watcher $lk_wpid$rel"
      fi ;;
    stale*) echo "  lock: STALE: ${state#stale }$rel"; bad=1 ;;
  esac
  for p in ${running[@]+"${running[@]}"}; do
    rel=${p#"$ws"/}
    case $state in
      none) echo "  warn: ${rel} is running with no lock (interactive run, or flip it by hand)" ;;
      live | setup)
        if [ -n "$lk_rel" ] && [ "$lk_rel" != "$rel" ]; then
          echo "  STALE: $rel is running but the lock is for $lk_rel"; bad=1
        fi ;;
    esac
  done

  line=$(awk -F'\t' -v w="$ws" '$2 == w { l = $0 } END { print l }' "$log" 2>/dev/null)
  if [ -n "$line" ]; then
    IFS=$'\t' read -r l_ts _ l_file _ l_exit l_secs _ <<<"$line"
    echo "  last: $l_file exit $l_exit ${l_secs}s $l_ts"
  else
    echo "  last: none"
  fi
  next_line "$ws" "$lw" "$l_done" "$l_blocked" "$l_failed" "$l_running" "$cnt_pending"
  return "$bad"
}

cmd_status() {
  local list ws bad=0 last alive_pid=""
  list=$(select_ws "$@") || exit 1
  # shellcheck disable=SC2016 # backticks are literal
  echo 'A `done` prompt is a branch waiting for your review and merge; nothing lands on `main` by itself, and the next `after:` prompt waits for that merge.'
  legacy_global | sed 's/^/warn: /'
  watcher_line || bad=1
  alive_pid=$(watcher_alive)
  if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux: not installed"
  elif tmux_has_session; then
    if [ -n "$alive_pid" ]; then echo "tmux: session '$session' present"
    else echo "STALE: tmux: session '$session' present but no live watcher"; bad=1; fi
  else
    echo "tmux: session '$session' absent"
  fi
  last=$(tail -n 1 "$log" 2>/dev/null | cut -f1)
  echo "log: $log${last:+ (last line $last)}"
  while IFS= read -r ws; do
    [ -n "$ws" ] || continue
    status_ws "$ws" || bad=1
  done <<<"$list"
  return "$bad"
}

cmd_recover() {
  local list ws state refused=0 did=0 dry=0 args=()
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) dry=1 ;;
      -*) usage ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  list=$(select_ws ${args[@]+"${args[@]}"}) || exit 1
  recover_dry=$dry
  while IFS= read -r ws; do
    [ -n "$ws" ] || continue
    state=$(lock_state "$ws")
    case $state in
      none) continue ;;
      live | setup)
        in_progress "$ws"
        echo "chirat-watch: $ws: lock is live, not recovering" >&2
        refused=1; continue ;;
    esac
    did=1
    recover_stale "$ws"
  done <<<"$list"
  [ "$did" = 1 ] || [ "$refused" = 1 ] || echo "nothing to recover"
  return "$refused"
}

cmd_restart() {
  local force=0 list ws state pid="" t secs flags=() f _
  case ${1:-} in --force) force=1; shift ;; esac
  [ $# -eq 0 ] || usage
  command -v tmux >/dev/null 2>&1 || die "tmux not installed"
  list=$(workspaces)
  while IFS= read -r ws; do
    [ -n "$ws" ] || continue
    state=$(lock_state "$ws")
    lock_read "$ws"
    if [ "$state" = live ] && [ -n "$lk_cpid" ] && claude_live "$lk_cpid" && [ "$force" = 0 ]; then
      secs=0
      if [ -n "$lk_started" ] && t=$(iso_to_epoch "$lk_started") && [ -n "$t" ]; then secs=$(($(date +%s) - t)); fi
      [ "$secs" -ge 0 ] || secs=0
      die "refusing to restart: ${lk_rel:--} is running (claude $lk_cpid, $(fmt_secs "$secs")); --force stops it and puts the prompt back to pending"
    fi
  done <<<"$list"

  if [ -f "$state_dir/watcher.flags" ]; then
    while IFS= read -r f; do [ -n "$f" ] && flags+=("$f"); done <"$state_dir/watcher.flags"
  fi
  pid=$(watcher_alive)
  if [ -z "$pid" ] && tmux_has_session; then
    pid=$(tmux list-panes -t "=$session" -F '#{pane_pid}' 2>/dev/null | head -n 1)
    [ -n "$pid" ] && alive "$pid" || pid=""
  fi
  if [ -n "$pid" ]; then
    echo "stopping watcher $pid"
    kill -TERM "$pid" 2>/dev/null
    if ! wait_gone "$pid" $((stop_grace + 10)); then
      echo "chirat-watch: watcher $pid did not stop within $((stop_grace + 10)) s, sending KILL" >&2
      kill -KILL "$pid" 2>/dev/null
      wait_gone "$pid" 5
      # The killed watcher could not clean up: apply its rule to the claude
      # group of every lock it held — gone, or left for the next watcher.
      while IFS= read -r ws; do
        [ -n "$ws" ] || continue
        lock_read "$ws"
        [ "$lk_wpid" = "$pid" ] && [ -n "$lk_cpid" ] || continue
        stop_group "$lk_cpid"
        case $? in
          0) echo "chirat-watch: $ws: stopped claude's process group $lk_cpid; the next pass recovers the lock" >&2 ;;
          *) echo "chirat-watch: $ws: claude's process group $lk_cpid is still alive or cannot be inspected; lock and prompt left as they are" >&2 ;;
        esac
      done <<<"$list"
    fi
  else
    echo "no watcher running; starting one"
  fi
  tmux_has_session && tmux kill-session -t "=$session"
  "$here/chirat-watch" --tmux ${flags[@]+"${flags[@]}"} || exit $?
  for _ in 1 2 3 4 5 6; do
    watcher_alive >/dev/null && break
    sleep 0.5
  done
  watcher_line
}

# ws_match <ws> <name…>: success when no names are given or one matches ws
# (a bare name `aat` matches `*/aat`)
ws_match() {
  local w=$1 a
  shift
  [ $# -gt 0 ] || return 0
  for a in "$@"; do
    a=${a/#\~/$HOME}
    a=${a%/}
    case $w in "$a" | */"$a") return 0 ;; esac
  done
  return 1
}

cmd_logs() {
  local n=20 follow=0 names=() w
  while [ $# -gt 0 ]; do
    case $1 in
      -n)
        [ $# -ge 2 ] || usage
        case $2 in '' | *[!0-9]*) die "-n needs a whole number" ;; esac
        n=$2; shift ;;
      -f) follow=1 ;;
      -*) usage ;;
      *) names+=("$1") ;;
    esac
    shift
  done
  if [ ! -f "$log" ]; then echo "no log yet"; return 0; fi
  # the ws column is the second tab-separated field; `waiting`, `misnamed` and
  # `legacy` lines carry it third, so match either
  filter() {
    if [ ${#names[@]} -eq 0 ]; then cat; return; fi
    while IFS= read -r line; do
      w=$(printf '%s\n' "$line" | cut -f2)
      case $w in waiting | misnamed | legacy) w=$(printf '%s\n' "$line" | cut -f3) ;; esac
      ws_match "$w" "${names[@]}" && printf '%s\n' "$line"
    done
  }
  if [ "$follow" = 1 ]; then
    tail -n "$n" -f "$log" | filter
  else
    # filter first, then cut to the last N matching lines
    filter <"$log" | tail -n "$n"
  fi
}

# transcript_filter: stdin = transcript lines, stdout = the turns to show
transcript_filter() {
  if command -v jq >/dev/null 2>&1 && [ "${CHIRAT_TAIL_PY:-0}" != 1 ]; then
    jq -R -r --unbuffered '
      fromjson? | select(type == "object" and .type == "assistant")
      | (.timestamp // "" | .[11:19]) as $t
      | (.message.content // [])[]? | objects
      | if .type == "text" then
          "\($t)  assistant  \((.text // "") | gsub("\\s+"; " ") | .[0:200])"
        elif .type == "tool_use" then
          (.input // {}) as $i
          | ($i.command // $i.file_path // $i.pattern
             // ([$i[] | select(type == "string")] | first) // "") as $a
          | "\($t)  tool       \(.name // "?")  \($a | tostring | gsub("\\s+"; " ") | .[0:120])"
        else empty end'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -u -c '
import json, re, sys
for line in sys.stdin:
    try:
        r = json.loads(line)
        if not isinstance(r, dict) or r.get("type") != "assistant":
            continue
        t = (r.get("timestamp") or "")[11:19]
        for c in (r.get("message") or {}).get("content") or []:
            if not isinstance(c, dict):
                continue
            if c.get("type") == "text":
                print("%s  assistant  %s" % (t, re.sub(r"\s+", " ", c.get("text") or "")[:200]), flush=True)
            elif c.get("type") == "tool_use":
                i = c.get("input") or {}
                a = i.get("command") or i.get("file_path") or i.get("pattern")
                if not a:
                    a = next((v for v in i.values() if isinstance(v, str)), "")
                print("%s  tool       %s  %s" % (t, c.get("name") or "?", re.sub(r"\s+", " ", str(a))[:120]), flush=True)
    except Exception:
        continue
'
  else
    echo "chirat-watch: needs jq or python3" >&2
    return 1
  fi
}

cmd_tail() {
  local follow=0 name="" ws lockws=() w started t dir f best=""
  while [ $# -gt 0 ]; do
    case $1 in
      -f) follow=1 ;;
      -*) usage ;;
      *) [ -z "$name" ] || usage; name=$1 ;;
    esac
    shift
  done
  command -v jq >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1 || die "needs jq or python3"
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    case $(lock_state "$w") in live | setup) lockws+=("$w") ;; esac
  done < <(if [ -n "$name" ]; then select_ws "$name" || exit 1; else workspaces; fi)
  if [ ${#lockws[@]} -eq 0 ]; then die "no run in progress${name:+ in $name}"; fi
  if [ ${#lockws[@]} -gt 1 ]; then die "several runs in progress (${lockws[*]}); name one"; fi
  ws=${lockws[0]}
  lock_read "$ws"
  started=$(iso_to_epoch "${lk_started:-}")
  dir=$HOME/.claude/projects/${ws//\//-}
  for f in "$dir"/*.jsonl; do
    [ -f "$f" ] || continue
    t=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null) || continue
    [ -z "$started" ] || [ "$t" -ge "$started" ] || continue
    if [ -z "$best" ] || [ "$f" -nt "$best" ]; then best=$f; fi
  done
  if [ -z "$best" ]; then echo "no transcript yet"; return 0; fi
  if [ "$follow" = 1 ]; then
    tail -n +1 -f "$best" | transcript_filter
  else
    transcript_filter <"$best"
  fi
}

# real_path <path>: `~` expanded, symlinks resolved, no trailing slash. A path
# whose parent does not exist comes back as given.
real_path() {
  local p=${1/#\~/$HOME} d
  p=${p%/}
  if [ -d "$p" ]; then
    (cd -P "$p" && pwd -P)
  else
    d=$(dirname "$p")
    if [ -d "$d" ]; then
      printf '%s/%s\n' "$(cd -P "$d" && pwd -P)" "$(basename "$p")"
    else
      printf '%s\n' "$p"
    fi
  fi
}

# doctor_workspace <ws>: the per-workspace checks, through cmd_doctor's ok / warn
# / fail. <ws> is a resolved path that has .chirat/.
doctor_workspace() {
  local ws=$1 q nl=$'\n' rec key val dir found=0 why c first="" want got wrong="" clones="" b cur missing=0 no
  q=$(printf '%s' "$ws" | sed 's/[\\"$`]/\\&/g')

  # --includes: --global alone does not follow include.path. -z: a key can hold
  # spaces, and git prints it with the subsection's case intact.
  why="no includeIf for it in ~/.gitconfig"
  while IFS= read -r -d '' rec; do
    key=${rec%%"$nl"*}
    val=${rec#*"$nl"}
    case $key in includeif.gitdir:*.path) ;; *) continue ;; esac
    dir=${key#includeif.gitdir:}
    dir=${dir%.path}
    [ "$(real_path "$dir")" = "$ws" ] || continue
    case $dir in
      */) ;;
      *) why="includeIf \"gitdir:$dir\" has no trailing /"; continue ;;
    esac
    if [ "$(real_path "$val")" = "$ws/.gitconfig" ]; then found=1
    else why="includeIf \"gitdir:$dir\" has path = $val, not $ws/.gitconfig"; fi
  done < <(git config --global --includes -z --get-regexp '^includeif\.' 2>/dev/null)
  if [ "$found" = 1 ]; then
    ok "includeIf: gitdir:$ws/"
  else
    fail "includeIf: $why"
    echo "     git config --global --add includeIf.\"gitdir:$q/\".path \"$q/.gitconfig\""
  fi

  for c in "$ws"/repos/*/; do
    if [ -e "${c}.git" ]; then first=${c%/}; break; fi
  done

  want=$(git config -f "$ws/.gitconfig" user.email 2>/dev/null)
  if [ -z "$want" ]; then
    fail "identity: no user.email in $ws/.gitconfig"
  else
    for c in "$ws" ${first:+"$first"}; do
      got=$(git -C "$c" config user.email 2>/dev/null)
      [ "$got" = "$want" ] || wrong="$wrong $c gives [$got];"
    done
    if [ -z "$wrong" ]; then ok "identity: $want"
    else fail "identity: $ws/.gitconfig has $want, but git in$wrong the include is not taking effect"; fi
  fi

  found=0
  if [ -f "$config" ]; then
    while IFS= read -r c; do
      if [ "$(real_path "$c")" = "$ws" ]; then found=1; fi
    done < <(workspaces)
  fi
  if [ "$found" = 1 ]; then
    ok "workspaces: registered in $config"
  else
    fail "workspaces: not in $config, the watcher will never run its prompts"
    echo "     mkdir -p \"$(dirname "$config")\" && echo \"$q\" >> \"$config\""
  fi

  if [ -z "$first" ]; then
    warn "repos: no clone under $ws/repos yet"
  else
    b=$(chirat_config "$ws" default_branch main)
    for c in "$ws"/repos/*/; do
      [ -e "${c}.git" ] || continue
      c=${c%/}
      clones="$clones ${c##*/}"
      if ! git -C "$c" show-ref --verify -q "refs/heads/$b"; then
        missing=1
        cur=$(git -C "$c" rev-parse --abbrev-ref HEAD 2>/dev/null)
        warn "default_branch: no local branch $b in repos/${c##*/}, which is on ${cur:-?}: set default_branch=${cur:-?} in $ws/.chirat/config"
      fi
    done
    ok "repos:$clones"
    [ "$missing" = 1 ] || ok "default_branch: $b"
  fi

  no=$(chirat_config "$ws" notify_open "")
  case $no in
    '') warn "notify_open: not set in $ws/.chirat/config, a notification click will not open your planning session" ;;
    *'<'* | *'>'*) warn "notify_open: placeholder left in $ws/.chirat/config: $no" ;;
    *) ok "notify_open: $no" ;;
  esac
}

cmd_doctor() {
  local online=0 bad=0 p ws n=0 cl="" dir real want pr_path v wl lm no doc_open="" target="" out fails
  while [ $# -gt 0 ]; do
    case $1 in
      --online) online=1 ;;
      -*) usage ;;
      *) [ -z "$target" ] || usage; target=$1 ;;
    esac
    shift
  done
  ok() { echo "ok   $*"; }
  warn() { echo "warn $*"; }
  fail() { echo "FAIL $*"; bad=1; }

  # 1, 2: claude
  if cl=$(command -v claude 2>/dev/null) && [ -n "$cl" ]; then
    v=$(claude --version 2>&1 | head -n 1)
    if [ -n "$v" ]; then ok "claude: $cl ($v)"; else fail "claude --version: prints nothing"; fi
  else
    fail "claude: not on PATH"
  fi
  if [ "$online" = 1 ] && [ -n "$cl" ]; then
    local out=$state_dir/doctor.$$.out err=$state_dir/doctor.$$.err cpid rc=0
    claude -p "reply with ok" --output-format json >"$out" 2>"$err" </dev/null &
    cpid=$!
    if wait_gone "$cpid" 60; then
      wait "$cpid"; rc=$?
    else
      kill -KILL "$cpid" 2>/dev/null; wait "$cpid" 2>/dev/null; rc=timeout
    fi
    if [ "$rc" = 0 ]; then ok "claude -p: answered"
    elif [ "$rc" = timeout ]; then fail "claude -p: no answer within 60 s"
    else fail "claude -p: exit $rc: $(head -n 1 "$err")"; fi
    rm -f "$out" "$err"
  fi

  # 3: plugin
  if [ -n "$cl" ]; then
    if claude plugin list 2>&1 | grep -q chirat; then ok "plugin: chirat installed"
    else fail "plugin: chirat not in \`claude plugin list\`: claude plugin marketplace add $root && claude plugin install chirat@chirat"; fi
  fi

  # 4: config
  while IFS= read -r lm; do warn "$lm"; done < <(legacy_global)
  if [ ! -f "$config" ]; then
    fail "config: $config missing"
  else
    while IFS= read -r ws; do
      [ -n "$ws" ] || continue
      n=$((n + 1))
      lm=$(legacy_ws_msg "$ws")
      [ -z "$lm" ] || warn "workspace $ws: $lm (skipped by the watcher)"
      if [ ! -d "$ws" ]; then fail "workspace $ws: no such directory"
      elif [ ! -d "$ws/$(chirat_config "$ws" plans_dir docs/plans)" ]; then fail "workspace $ws: no $(chirat_config "$ws" plans_dir docs/plans)"
      else
        ok "workspace $ws"
        lm=$(legacy_msg "$ws")
        [ -z "$lm" ] || warn "workspace $ws: $lm"
        no=$(chirat_config "$ws" notify_open "")
        if [ -n "$no" ]; then
          case $no in
            claude://* | https://* | file://*) ;;
            *) [ -e "$no" ] || warn "notify_open: unrecognized value $no ($ws)" ;;
          esac
          [ -n "$doc_open" ] || doc_open=$no
        fi
      fi
    done < <(workspaces)
    [ "$n" -gt 0 ] || warn "no workspaces: $config has no entries"
  fi

  # 5: tmux
  if command -v tmux >/dev/null 2>&1; then
    ok "tmux: $(command -v tmux)"
    if tmux has-session -t "=relay" 2>/dev/null; then warn "old watcher still running: tmux kill-session -t relay"; fi
  else
    warn "tmux: not installed (--once works without it)"
  fi

  # 6: our own commands
  for p in chirat-prompt chirat-watch; do
    want=$here/chirat-watch
    [ "$p" = chirat-prompt ] && want=$chirat_prompt
    if ! pr_path=$(command -v "$p" 2>/dev/null) || [ -z "$pr_path" ]; then
      fail "$p: not on PATH: run \`$here/chirat-watch install\` and add ~/.local/bin to PATH: export PATH=\"\$HOME/.local/bin:\$PATH\""
      continue
    fi
    real=$pr_path
    while [ -L "$real" ]; do
      dir=$(readlink "$real")
      case $dir in /*) real=$dir ;; *) real=$(dirname "$real")/$dir ;; esac
    done
    if [ "$(cd "$(dirname "$real")" && pwd)/$(basename "$real")" = "$(cd "$(dirname "$want")" && pwd)/$(basename "$want")" ]; then
      ok "$p: $pr_path"
    else
      warn "$p: resolves to $pr_path, this checkout has $want"
    fi
  done
  for p in relay-watch relay-prompt; do
    if pr_path=$(command -v "$p" 2>/dev/null) && [ -n "$pr_path" ]; then
      warn "$p: old command still on PATH: rm $pr_path"
    fi
  done

  # 7: state dir, osascript, jq
  if [ -w "$state_dir" ]; then ok "state dir: $state_dir writable"; else fail "state dir: $state_dir not writable"; fi
  if command -v terminal-notifier >/dev/null 2>&1; then
    local tnv tnr tnerr2
    tnv=$(terminal-notifier -version 2>/dev/null | head -n 1) || tnv=""
    # real output: "terminal-notifier 3.1.0." — keep the first number run
    tnv=$(printf '%s\n' "$tnv" | grep -o '[0-9][0-9.]*' | head -n 1)
    tnv=${tnv%.}
    [ -n "$tnv" ] || tnv="?"
    case $tnv in
      3.*) ok "terminal-notifier 3.x: click opens ${doc_open:-Claude}" ;;
      *) warn "terminal-notifier $tnv: 3.x needed for -open; brew upgrade terminal-notifier" ;;
    esac
    if [ "$online" = 1 ]; then
      tnerr2=$(terminal-notifier -title chirat -message "doctor probe" -group chirat:doctor 2>&1 >/dev/null) || true
      case $tnerr2 in
        *"not allowed"*)
          tnr=$(tn_app_path)
          fail "terminal-notifier: notifications not allowed — run: open \"$tnr\" once and click Allow"
          ;;
        *) ok "terminal-notifier: permission granted" ;;
      esac
    fi
  elif command -v osascript >/dev/null 2>&1; then
    warn "notifications via osascript: shown as \"Script Editor\", click does nothing — brew install terminal-notifier"
  elif [ "$(uname)" = Darwin ]; then warn "no notifier found"
  else echo "info notifier: not present (macOS only)"; fi
  if command -v jq >/dev/null 2>&1; then ok "jq: $(command -v jq)"
  else warn "jq: not installed (tail falls back to python3)"; fi

  # 8: watcher
  if wl=$(watcher_line); then ok "$wl"; else fail "${wl#STALE: }"; fi

  # 9: one workspace in full, or one line per registered workspace
  if [ -n "$target" ]; then
    ws=$(real_path "$target")
    if [ ! -d "$ws" ]; then fail "workspace $ws: no such directory"
    elif [ ! -d "$ws/.chirat" ]; then fail "workspace $ws: not a workspace (no .chirat/)"
    else doctor_workspace "$ws"; fi
  elif [ -f "$config" ]; then
    while IFS= read -r ws; do
      [ -n "$ws" ] || continue
      if [ ! -d "$ws/.chirat" ]; then
        echo "${ws##*/}: not a workspace (no .chirat/)"
        continue
      fi
      out=$(doctor_workspace "$(real_path "$ws")")
      fails=$(printf '%s\n' "$out" | sed -n 's/^FAIL \([A-Za-z_]*\):.*/\1 FAIL/p' | paste -sd, - | sed 's/,/, /g')
      echo "${ws##*/}: ${fails:-ok}"
    done < <(workspaces)
  fi
  return "$bad"
}

if [ -n "$sub" ]; then
  "cmd_$sub" ${sub_args[@]+"${sub_args[@]}"}
  exit $?
fi

# Record this watcher for status / restart; the files go away with it, unless
# a newer watcher has already replaced them. Not under --dry-run, which must
# not touch a live watcher's files either.
if [ "$dry_run" = 0 ]; then
  printf '%s\n' "$$" >"$state_dir/watcher.pid"
  if [ ${#pass_through[@]} -gt 0 ]; then
    printf '%s\n' "${pass_through[@]}" >"$state_dir/watcher.flags"
  else
    : >"$state_dir/watcher.flags"
  fi
fi
forget_watcher() {
  [ "$dry_run" = 0 ] || return 0
  if [ "$(cat "$state_dir/watcher.pid" 2>/dev/null)" = "$$" ]; then
    rm -f "$state_dir/watcher.pid" "$state_dir/watcher.flags"
  fi
}
trap forget_watcher EXIT
if [ "$once" = 1 ]; then
  pass
  exit 0
fi

while :; do
  pass
  sleep "$interval" &
  child=$!
  wait "$child"
  child=""
done
